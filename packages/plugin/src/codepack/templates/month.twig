{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Month" %}
{% set page = "month" %}

{% block content %}

    {% set targetDate = "today" %}
    {% set calendarHandle = null %}
    {% if segment3 == "calendar" %}
        {% set calendarHandle = segment4 %}
        {% if segment5 %}
            {% set targetDate = segment5~"-"~segment6~"-01" %}
        {% endif %}
    {% elseif segment3 is not empty %}
        {% set targetDate = segment3~"-"~segment4~"-01" %}
    {% endif %}

    <div class="month-layout">
        <div class="month-layout-main">

            {% include "demo/layouts/_calendar_banner" %}

            <section id="month_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4">
                {% set month = calendar.month({
                    date: targetDate,
                    calendar: calendarHandle,
                }) %}

                {% set occurrenceCount = month.occurrenceCount %}
                {% set dateBoundsHelper = now.diff(month.nextDate)|date('%r%a') %}

                <div class="row align-items-center g-2 mb-3">
                    <div class="col-6 col-md-3 order-1 order-md-0">
                        {% if dateBoundsHelper > -365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/month/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ month.previousDate.format('Y/m') }}">
                                <span class="fas fa-arrow-left" aria-hidden="true"></span> {{ month.previousDate.format('F') }}
                            </a>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6 order-0 text-center">
                        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                            {% include "demo/layouts/_month_heading" with {month: month, calendarHandle: calendarHandle} only %}
                            <span class="badge rounded-pill bg-body-tertiary border text-body-secondary fw-normal fs-6">
                                {{ occurrenceCount }} event{{ occurrenceCount > 1 or occurrenceCount == 0 ? "s" }}
                            </span>
                        </div>
                    </div>

                    <div class="col-6 col-md-3 order-2 text-end">
                        {% if dateBoundsHelper < 365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/month/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ month.nextDate.format('Y/m') }}">
                                {{ month.nextDate.format('F') }} <span class="fas fa-arrow-right" aria-hidden="true"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="month_calendar_inner" class="table table-bordered mb-0">
                        <caption class="visually-hidden">Events for {{ month.date.format('F Y') }}</caption>
                        <thead>
                            <tr id="days_of_week">
                                {% for day in month|first %}
                                    <th class="day_of_week" scope="col"><abbr class="text-decoration-none" title="{{ day.date.format('l') }}">{{ day.date.format('D') }}</abbr></th>
                                {% endfor %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for week in month %}
                                <tr>
                                    {% for day in week %}
                                        {% set inMonth = month.containsDate(day.date) %}
                                        <td class="day_cell{{ not inMonth ? ' out_of_range' }}{{ inMonth and day.dateLocalized.isToday ? ' today bg-primary-subtle' }}">
                                            <div class="date{{ inMonth and day.occurrenceCount ? ' has_events' }}">
                                                {% if inMonth %}
                                                    <a class="num" aria-label="{{ day.dateLocalized.isToday ? 'Today, ' }}{{ day.date.format('F j, Y') }}"
                                                        href="{{ siteUrl }}demo/day/{{ segment3 == 'calendar' ? "calendar/"~segment4~"/" }}{{ day.date.format('Y/m/d') }}">
                                                        {{ day.date.format('j') }}
                                                    </a>
                                                {% else %}
                                                    <span class="num">{{ day.date.format('j') }}</span>
                                                {% endif %}
                                            </div>
                                            {% for occurrence in day.occurrences %}
                                                {% include "demo/layouts/_occurrence" %}
                                            {% endfor %}
                                        </td>
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

        </div>

        <details class="month-sidebar">
            <summary class="month-sidebar-toggle rounded-4 shadow-sm bg-body fw-semibold">
                <span class="fas fa-calendar-alt" aria-hidden="true"></span>
                <span>Calendars</span>
                <span class="fas fa-chevron-right month-sidebar-chevron" aria-hidden="true"></span>
            </summary>
            <div class="month-sidebar-content mt-2">
                {% include "demo/layouts/_sidebar" %}
            </div>
        </details>
    </div>

{% endblock %}
