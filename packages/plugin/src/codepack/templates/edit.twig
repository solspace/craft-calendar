{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Event" %}
{% set page = "edit" %}
{% set currentSite = craft.app.sites.currentSite %}
{% set routeEventId = id is defined ? id : 'new' %}
{% set allowedCalendars = [] %}

{% for calendar in craft.calendar.allowedCalendars %}
    {% if calendar.getSiteSettingsForSite(currentSite.id) %}
        {% set allowedCalendars = allowedCalendars|merge([calendar]) %}
    {% endif %}
{% endfor %}

{% if event is not defined %}
    {% if routeEventId == 'new' and allowedCalendars|length %}
        {% set selectedCalendar = allowedCalendars|first %}
        {% set requestedCalendarId = craft.app.request.get('calendarId') %}

        {% for calendar in allowedCalendars %}
            {% if requestedCalendarId and calendar.id == requestedCalendarId %}
                {% set selectedCalendar = calendar %}
            {% endif %}
        {% endfor %}

        {% set event = craft.calendar.createEvent(currentSite.id, selectedCalendar.id) %}
    {% elseif routeEventId != 'new' %}
        {% set event = craft.calendar.events({
            id: routeEventId,
            siteId: currentSite.id,
            status: null,
        }).one() %}
    {% else %}
        {% set event = null %}
    {% endif %}
{% endif %}

{% block content %}
    <h1 class="h4 mb-4">{{ routeEventId == 'new' ? 'Create Event'|t : 'Edit Event'|t }}</h1>

    <div class="row">
        <div class="col-12">
            {% if event %}
                {% requireEventEditPermissions event %}
                {% set recurrenceEnabled = craft.calendar.isPro and event.calendar.allowRepeatingEvents %}
                {% set scheduleLocked = not recurrenceEnabled and event.rrule %}

                <form method="post" data-event-form>
                    {{ csrfInput() }}
                    <input type="hidden" name="action" value="calendar/events-api/save">
                    <input type="hidden" name="redirect" value="{{ url('%prefix%/event/{id}')|hash }}">
                    <input type="hidden" name="eventId" value="{{ event.id }}">
                    <input type="hidden" name="siteId" value="{{ event.siteId ?? currentSite.id }}">
                    <input type="hidden" name="timezone" value="{{ event.timezone ?? craft.app.timezone }}">
                    <input type="hidden" name="start" value="{{ event.getStartDate().format('Y-m-d\\TH:i:s') }}" data-start>
                    <input type="hidden" name="end" value="{{ event.getEndDate().format('Y-m-d\\TH:i:s') }}" data-end>
                    <input type="hidden" name="until" value="{{ event.getUntil() ? event.getUntil().format('Y-m-d\\TH:i:s') : '' }}" data-until>
                    <input type="hidden" name="repeatType" value="{{ event.repeatType ?? 'NEVER' }}" data-repeat-type-value>
                    <input type="hidden" name="repeatEndType" value="{{ event.repeatEndType ?? 'NEVER' }}" data-repeat-end-value>
                    <input type="hidden" name="rrule" value="{{ event.rrule }}" data-rrule>

                    {% if event.slug %}
                        <input type="hidden" name="slug" value="{{ event.slug }}">
                    {% endif %}

                    {% if errors is defined and errors %}
                        <div class="alert alert-danger" role="alert">
                            <strong>{{ 'Could not save event.'|t }}</strong>
                            <ul class="mb-0 mt-2">
                                {% for fieldErrors in errors %}
                                    {% for error in fieldErrors %}
                                        <li>{{ error }}</li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="event-title">{{ 'Title'|t }}</label>
                        <div class="col-sm-10">
                            <input id="event-title" type="text" name="title" value="{{ event.title }}" class="form-control" required>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label" for="event-calendar">{{ 'Calendar'|t }}</label>
                        <div class="col-sm-10 col-md-5">
                            {% if event.id %}
                                <input type="hidden" name="calendarId" value="{{ event.calendarId }}">
                                <input id="event-calendar" type="text" class="form-control" value="{{ event.calendar.name }}" readonly>
                            {% else %}
                                <select id="event-calendar" name="calendarId" class="form-select" data-calendar-selector>
                                    {% for calendar in allowedCalendars %}
                                        <option value="{{ calendar.id }}" {{ calendar.id == event.calendarId ? 'selected' }}>{{ calendar.name }}</option>
                                    {% endfor %}
                                </select>
                                <small class="form-text text-body-secondary">
                                    {{ 'Changing the calendar reloads this new event with the selected calendar’s settings.'|t }}
                                </small>
                            {% endif %}
                        </div>
                    </div>

                    <fieldset class="event-editor-card">
                        <legend>{{ 'Schedule'|t }}</legend>

                        <div class="row mb-3">
                            <div class="col-sm-2 col-form-label">{{ 'All Day'|t }}</div>
                            <div class="col-sm-10">
                                <input type="hidden" name="allDay" value="{{ event.allDay ? 1 : 0 }}" data-all-day-value>
                                <div class="form-check pt-2">
                                    <input id="event-all-day" class="form-check-input" type="checkbox" data-all-day {{ event.allDay ? 'checked' }} {{ scheduleLocked ? 'disabled' }}>
                                    <label class="form-check-label" for="event-all-day">{{ 'This is an all-day event'|t }}</label>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="event-start-date">{{ 'Starts'|t }}</label>
                            <div class="col-sm-5 col-md-4">
                                <input id="event-start-date" class="form-control" type="date" value="{{ event.getStartDate().format('Y-m-d') }}" data-start-date required {{ scheduleLocked ? 'disabled' }}>
                            </div>
                            <div class="col-sm-3 col-md-2" data-time-field>
                                <input class="form-control" type="time" aria-label="{{ 'Start time'|t }}" value="{{ event.getStartDate().format('H:i') }}" data-start-time required {{ scheduleLocked ? 'disabled' }}>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="event-end-date">{{ 'Ends'|t }}</label>
                            <div class="col-sm-5 col-md-4">
                                <input id="event-end-date" class="form-control" type="date" value="{{ event.getEndDate().format('Y-m-d') }}" data-end-date required {{ scheduleLocked ? 'disabled' }}>
                                <small class="form-text text-body-secondary" data-all-day-help hidden>
                                    {{ 'For all-day events, this is the exclusive end date.'|t }}
                                </small>
                            </div>
                            <div class="col-sm-3 col-md-2" data-time-field>
                                <input class="form-control" type="time" aria-label="{{ 'End time'|t }}" value="{{ event.getEndDate().format('H:i') }}" data-end-time required {{ scheduleLocked ? 'disabled' }}>
                            </div>
                        </div>
                    </fieldset>

                    {% if recurrenceEnabled %}
                        <fieldset class="event-editor-card">
                            <legend>{{ 'Recurrence'|t }}</legend>

                            <div class="alert alert-info" data-complex-rule-warning hidden>
                                {{ 'This event contains multiple RRULE lines. The schedule is preserved but this simplified demo does not edit multi-rule sets.'|t }}
                            </div>

                            <div class="row mb-3">
                                <label class="col-sm-2 col-form-label" for="event-repeat-type">{{ 'Repeats'|t }}</label>
                                <div class="col-sm-5 col-md-4">
                                    <select id="event-repeat-type" class="form-select" data-repeat-type>
                                        <option value="NEVER">{{ 'Never'|t }}</option>
                                        <option value="DAILY">{{ 'Every Day'|t }}</option>
                                        <option value="WEEKLY">{{ 'Every Week'|t }}</option>
                                        <option value="MONTHLY">{{ 'Every Month'|t }}</option>
                                        <option value="YEARLY">{{ 'Every Year'|t }}</option>
                                        <option value="CUSTOM">{{ 'Custom Rule'|t }}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="custom-rule-builder" data-custom-rule hidden>
                                <div class="custom-rule-builder__lead">
                                    <span>{{ 'Every'|t }}</span>
                                    <input class="form-control" type="number" min="1" step="1" value="1" data-interval aria-label="{{ 'Interval'|t }}">
                                    <select id="event-frequency" class="form-select" data-frequency aria-label="{{ 'Frequency'|t }}">
                                        <option value="DAILY">{{ 'day(s)'|t }}</option>
                                        <option value="WEEKLY">{{ 'week(s)'|t }}</option>
                                        <option value="MONTHLY">{{ 'month(s)'|t }}</option>
                                        <option value="YEARLY">{{ 'year(s)'|t }}</option>
                                    </select>
                                </div>

                                <div class="custom-rule-panel" data-frequency-panel="DAILY">
                                    <p>{{ 'The event repeats at the selected start time.'|t }}</p>
                                </div>

                                <div class="custom-rule-panel" data-frequency-panel="WEEKLY" hidden>
                                    <span class="custom-rule-label">{{ 'Repeat on'|t }}</span>
                                    <div class="rule-matrix rule-matrix--week" data-weekday-matrix>
                                        {% for value, label in {
                                            MO: 'Mon'|t,
                                            TU: 'Tue'|t,
                                            WE: 'Wed'|t,
                                            TH: 'Thu'|t,
                                            FR: 'Fri'|t,
                                            SA: 'Sat'|t,
                                            SU: 'Sun'|t,
                                        } %}
                                            <button type="button" class="rule-matrix__button" data-weekday="{{ value }}" aria-pressed="false">{{ label }}</button>
                                        {% endfor %}
                                    </div>
                                </div>

                                <div class="custom-rule-panel" data-frequency-panel="MONTHLY" hidden>
                                    <div class="custom-rule-choice">
                                        <label for="monthly-rule-mode">{{ 'Repeat on'|t }}</label>
                                        <select id="monthly-rule-mode" class="form-select" data-monthly-mode>
                                            <option value="MONTHDAY">{{ 'specific days of the month'|t }}</option>
                                            <option value="WEEKDAY">{{ 'an ordinal weekday'|t }}</option>
                                        </select>
                                    </div>

                                    <div data-monthly-monthday>
                                        <div class="rule-matrix rule-matrix--days" data-monthday-matrix>
                                            {% for day in 1..31 %}
                                                <button type="button" class="rule-matrix__button" data-monthday="{{ day }}" aria-pressed="false">{{ day }}</button>
                                            {% endfor %}
                                            <button type="button" class="rule-matrix__button rule-matrix__button--wide" data-monthday="-1" aria-pressed="false">{{ 'Last'|t }}</button>
                                        </div>
                                    </div>

                                    <div class="custom-rule-nth" data-monthly-weekday hidden>
                                        <select class="form-select" data-monthly-position aria-label="{{ 'Position'|t }}">
                                            <option value="1">{{ 'First'|t }}</option>
                                            <option value="2">{{ 'Second'|t }}</option>
                                            <option value="3">{{ 'Third'|t }}</option>
                                            <option value="4">{{ 'Fourth'|t }}</option>
                                            <option value="-1">{{ 'Last'|t }}</option>
                                        </select>
                                        <select class="form-select" data-monthly-weekday-choice aria-label="{{ 'Weekday'|t }}">
                                            <option value="MO">{{ 'Monday'|t }}</option>
                                            <option value="TU">{{ 'Tuesday'|t }}</option>
                                            <option value="WE">{{ 'Wednesday'|t }}</option>
                                            <option value="TH">{{ 'Thursday'|t }}</option>
                                            <option value="FR">{{ 'Friday'|t }}</option>
                                            <option value="SA">{{ 'Saturday'|t }}</option>
                                            <option value="SU">{{ 'Sunday'|t }}</option>
                                            <option value="WD">{{ 'Weekday (Mon-Fri)'|t }}</option>
                                            <option value="WEK">{{ 'Weekend day (Sat-Sun)'|t }}</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="custom-rule-panel" data-frequency-panel="YEARLY" hidden>
                                    <span class="custom-rule-label">{{ 'In'|t }}</span>
                                    <div class="rule-matrix rule-matrix--months" data-month-matrix>
                                        {% for month, label in {
                                            1: 'Jan'|t,
                                            2: 'Feb'|t,
                                            3: 'Mar'|t,
                                            4: 'Apr'|t,
                                            5: 'May'|t,
                                            6: 'Jun'|t,
                                            7: 'Jul'|t,
                                            8: 'Aug'|t,
                                            9: 'Sep'|t,
                                            10: 'Oct'|t,
                                            11: 'Nov'|t,
                                            12: 'Dec'|t,
                                        } %}
                                            <button type="button" class="rule-matrix__button" data-month="{{ month }}" aria-pressed="false">{{ label }}</button>
                                        {% endfor %}
                                    </div>

                                    <div class="custom-rule-choice">
                                        <label for="yearly-rule-mode">{{ 'Repeat on'|t }}</label>
                                        <select id="yearly-rule-mode" class="form-select" data-yearly-mode>
                                            <option value="MONTHDAY">{{ 'specific dates'|t }}</option>
                                            <option value="WEEKDAY">{{ 'an ordinal weekday'|t }}</option>
                                        </select>
                                    </div>

                                    <div data-yearly-monthday>
                                        <div class="rule-matrix rule-matrix--days" data-yearly-monthday-matrix>
                                            {% for day in 1..31 %}
                                                <button type="button" class="rule-matrix__button" data-yearly-monthday="{{ day }}" aria-pressed="false">{{ day }}</button>
                                            {% endfor %}
                                            <button type="button" class="rule-matrix__button rule-matrix__button--wide" data-yearly-monthday="-1" aria-pressed="false">{{ 'Last'|t }}</button>
                                        </div>
                                    </div>

                                    <div class="custom-rule-nth" data-yearly-weekday hidden>
                                        <select class="form-select" data-yearly-position aria-label="{{ 'Position'|t }}">
                                            <option value="1">{{ 'First'|t }}</option>
                                            <option value="2">{{ 'Second'|t }}</option>
                                            <option value="3">{{ 'Third'|t }}</option>
                                            <option value="4">{{ 'Fourth'|t }}</option>
                                            <option value="-1">{{ 'Last'|t }}</option>
                                        </select>
                                        <select class="form-select" data-yearly-weekday-choice aria-label="{{ 'Weekday'|t }}">
                                            <option value="MO">{{ 'Monday'|t }}</option>
                                            <option value="TU">{{ 'Tuesday'|t }}</option>
                                            <option value="WE">{{ 'Wednesday'|t }}</option>
                                            <option value="TH">{{ 'Thursday'|t }}</option>
                                            <option value="FR">{{ 'Friday'|t }}</option>
                                            <option value="SA">{{ 'Saturday'|t }}</option>
                                            <option value="SU">{{ 'Sunday'|t }}</option>
                                            <option value="WD">{{ 'Weekday (Mon-Fri)'|t }}</option>
                                            <option value="WEK">{{ 'Weekend day (Sat-Sun)'|t }}</option>
                                        </select>
                                    </div>
                                </div>

                                <input type="hidden" data-by-day>
                                <input type="hidden" data-by-month-day>
                                <input type="hidden" data-by-month>
                                <input type="hidden" data-by-set-position>

                                <details class="custom-rule-advanced">
                                    <summary>{{ 'Advanced RFC options'|t }}</summary>
                                    <div class="custom-rule-advanced__fields">
                                        <div>
                                            <label for="event-by-year-day">{{ 'Year days'|t }}</label>
                                            <input id="event-by-year-day" class="form-control" type="text" placeholder="1,100,-1" data-by-year-day>
                                        </div>
                                        <div>
                                            <label for="event-extra-rule-parts">{{ 'Additional rule parts'|t }}</label>
                                            <input id="event-extra-rule-parts" class="form-control" type="text" placeholder="BYWEEKNO=1;WKST=MO" data-extra-rule-parts>
                                        </div>
                                    </div>
                                </details>
                            </div>

                            <div data-repeat-end-row hidden>
                                <div class="row mb-3">
                                    <label class="col-sm-2 col-form-label" for="event-repeat-end">{{ 'Ends'|t }}</label>
                                    <div class="col-sm-5 col-md-4">
                                        <select id="event-repeat-end" class="form-select" data-repeat-end>
                                            <option value="NEVER">{{ 'Never'|t }}</option>
                                            <option value="AFTER">{{ 'After a number of occurrences'|t }}</option>
                                            <option value="ON_DATE">{{ 'On a date'|t }}</option>
                                        </select>
                                    </div>
                                    <div class="col-sm-3 col-md-2" data-count-field hidden>
                                        <input class="form-control" type="number" min="1" step="1" value="1" data-count aria-label="{{ 'Occurrences'|t }}">
                                    </div>
                                    <div class="col-sm-4 col-md-3" data-until-field hidden>
                                        <input class="form-control" type="date" data-until-date aria-label="{{ 'Until date'|t }}">
                                    </div>
                                </div>
                            </div>

                            <div class="fixed-date-manager">
                                <h2 class="h5">{{ 'Additional Dates'|t }}</h2>
                                <div class="d-flex flex-wrap gap-2">
                                    <input class="form-control w-auto" type="date" data-rdate-picker aria-label="{{ 'Additional date'|t }}">
                                    <button class="btn btn-outline-success" type="button" data-add-rdate>{{ 'Add Dates'|t }}</button>
                                </div>
                                <ul class="fixed-date-list" data-rdate-list></ul>
                            </div>

                            <div class="fixed-date-manager" data-exceptions hidden>
                                <h2 class="h5">{{ 'Excluded Dates'|t }}</h2>
                                <div class="d-flex flex-wrap gap-2">
                                    <input class="form-control w-auto" type="date" data-exdate-picker aria-label="{{ 'Excluded date'|t }}">
                                    <button class="btn btn-outline-danger" type="button" data-add-exdate>{{ 'Exclude Occurrence'|t }}</button>
                                </div>
                                <ul class="fixed-date-list" data-exdate-list></ul>
                            </div>
                        </fieldset>
                    {% elseif event.rrule %}
                        <div class="alert alert-info">
                            {{ 'This event’s recurrence is preserved, but recurrence editing is disabled for this calendar.'|t }}
                        </div>
                    {% endif %}

                    {% if event['location'] is defined %}
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="event-location">{{ 'Location'|t }}</label>
                            <div class="col-sm-10">
                                <input id="event-location" type="text" name="fields[location]" value="{{ event.location }}" class="form-control">
                            </div>
                        </div>
                    {% endif %}

                    {% if event['description'] is defined %}
                        <div class="row mb-3">
                            <label class="col-sm-2 col-form-label" for="event-description">{{ 'Description'|t }}</label>
                            <div class="col-sm-10">
                                <textarea id="event-description" name="fields[description]" class="form-control">{{ event.description }}</textarea>
                            </div>
                        </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-12 col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-success">{{ 'Save Event'|t }}</button>
                        </div>
                    </div>

                    <script type="application/json" data-event-config>{{ {
                        recurrenceEnabled: recurrenceEnabled,
                        scheduleLocked: scheduleLocked,
                        allDay: event.allDay,
                        rrule: event.rrule ?? '',
                        repeatType: event.repeatType ?? 'NEVER',
                        repeatEndType: event.repeatEndType ?? 'NEVER',
                        labels: {
                            endMustBeAfterStart: 'End must be after start.'|t,
                        },
                    }|json_encode(15)|raw }}</script>
                </form>
            {% elseif allowedCalendars is empty %}
                <div class="alert alert-warning" role="alert">{{ 'No calendars are available for event creation on this site.'|t }}</div>
            {% else %}
                <div class="alert alert-danger" role="alert">{{ 'Sorry, no event was found.'|t }}</div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block footerJs %}
    {{ parent() }}
    <script src="{{ siteUrl }}assets/demo/js/event-editor.js"></script>
{% endblock %}
