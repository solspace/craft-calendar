{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Events List" %}
{% set page = "events" %}

{% macro pager(pageInfo) %}
    {% if pageInfo.totalPages > 1 %}
        <nav aria-label="Events pages">
            <ul class="pagination flex-wrap mb-0">
                {% if pageInfo.prevUrl %}
                    <li class="page-item">
                        <a class="page-link" href="{{ pageInfo.prevUrl }}">&laquo; Previous</a>
                    </li>
                {% endif %}

                {% for page, url in pageInfo.getPrevUrls(3) %}
                    <li class="page-item">
                        <a class="page-link" href="{{ url }}">{{ page }}</a>
                    </li>
                {% endfor %}

                <li class="page-item active" aria-current="page">
                    <span class="page-link">{{ pageInfo.currentPage }}</span>
                </li>

                {% for page, url in pageInfo.getNextUrls(3) %}
                    <li class="page-item">
                        <a class="page-link" href="{{ url }}">{{ page }}</a>
                    </li>
                {% endfor %}

                {% if pageInfo.nextUrl %}
                    <li class="page-item">
                        <a class="page-link" href="{{ pageInfo.nextUrl }}">Next &raquo;</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endmacro %}
{% from _self import pager %}

{% block content %}

    {% set isMonthView = segment3 and segment4 and segment5 %}
    {% if isMonthView %}
        {% set targetStartDate = segment3 ~ '-' ~ segment4 ~ '-01' %}
        {% set targetEndDate = segment3 ~ '-' ~ segment4 ~ '-' ~ segment5 %}
    {% else %}
        {% set targetStartDate = 'today' %}
        {% set targetEndDate = '+30 days' %}
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-9">

            {% set eventOptions = {
                rangeStart: targetStartDate,
                rangeEnd: targetEndDate,
                limit: 15,
                orderBy: {startDate: constant('SORT_ASC')}
            } %}

            {% paginate calendar.occurrences(eventOptions) as pageInfo, occurrences %}

            <section id="events_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4" aria-labelledby="events-heading">
                <h1 id="events-heading" class="h4 mb-3 d-flex flex-wrap align-items-center gap-2">
                    <span>{{ isMonthView ? targetStartDate|date('F Y') : 'Upcoming Events' }}</span>
                    <span class="badge rounded-pill bg-body-tertiary border text-body-secondary fw-normal fs-6">
                        {{ pageInfo.total }} event{{ pageInfo.total == 1 ? '' : 's' }}
                    </span>
                </h1>

                <ul class="list-unstyled border-top mb-0">
                    {% for occurrence in occurrences %}
                        {% set event = occurrence.event %}
                        <li class="d-flex flex-column flex-sm-row align-items-start gap-2 gap-sm-3 py-3 px-2 px-md-3{{ not loop.first ? ' border-top' }}">
                            <div class="events-date pt-sm-1">
                                <a class="d-inline-flex align-items-center gap-2 link-body-emphasis link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                    href="{{ siteUrl }}demo/day/{{ occurrence.startDate.format('Y/m/d') }}"
                                    aria-label="{{ occurrence.startDate.format('l, F j, Y') }}">
                                    <time class="d-inline-flex align-items-center gap-2" datetime="{{ occurrence.startDate.format('Y-m-d') }}">
                                        <span class="fs-3 lh-1">{{ occurrence.startDate.format('j') }}</span>
                                        <span class="d-inline-flex flex-column small lh-sm">
                                            <span>{{ occurrence.startDate.format('D') }}</span>
                                            <span class="text-body-secondary">{{ occurrence.startDate.format('M') }}</span>
                                        </span>
                                    </time>
                                </a>
                            </div>
                            <article class="calendar-agenda-event position-relative flex-grow-1 bg-body-tertiary rounded-3 px-3 py-2"
                                style="--calendar-color: {{ event.calendar.color }};">
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <h2 class="h6 mb-1">
                                            <a href="{{ siteUrl }}demo/event/{{ event.id }}{% if event.repeats() or event.rrule is not empty %}/{{ occurrence.startDate.format('Y/m/d') }}{% endif %}"
                                                class="link-body-emphasis link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                                                {{ event.title }}
                                            </a>
                                        </h2>
                                        <div class="small text-body-secondary">
                                            <span class="far fa-clock" aria-hidden="true"></span>
                                            {% if event.allDay %}
                                                All day
                                            {% elseif event.multiDay %}
                                                {{ occurrence.startDate.format('g:ia') }} – {{ occurrence.endDate.format('M j, g:ia') }}
                                            {% else %}
                                                {{ occurrence.startDate.format('g:ia') }} – {{ occurrence.endDate.format('g:ia') }}
                                            {% endif %}
                                            {% if event['location'] is defined and event.location is not empty %}
                                                <span class="mx-1" aria-hidden="true">·</span>
                                                <span class="fas fa-map-marker-alt" aria-hidden="true"></span> {{ event.location|striptags }}
                                            {% endif %}
                                        </div>
                                    </div>
                                    <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}"
                                        class="badge rounded-pill bg-body-tertiary text-body border text-decoration-none fw-normal">
                                        <span class="fas fa-calendar-alt calendar-color-icon me-1" aria-hidden="true"></span>
                                        {{ event.calendar.name }}
                                    </a>
                                </div>
                                {% if event['description'] is defined and event.description is not empty %}
                                    <p class="small text-body-secondary mt-2 mb-0">{{ event.description|striptags }}</p>
                                {% endif %}
                            </article>
                        </li>
                    {% else %}
                        <li class="text-center text-body-secondary py-4">
                            {{ isMonthView ? 'No events found for this month.' : 'No events scheduled over the next 30 days.' }}
                        </li>
                    {% endfor %}
                </ul>

                {% if pageInfo.totalPages > 1 %}
                    <div class="border-top pt-3">
                        {{ pager(pageInfo) }}
                    </div>
                {% endif %}
            </section>
        </div>

        <div class="col-lg-3">
            {% include "demo/layouts/_sidebar" %}
            <section class="card border-0 rounded-4 shadow-sm mt-4">
                <div class="card-body">
                    {% set month = craft.calendar.month({date: targetStartDate, calendarId: 0}) %}
                    <h2 class="h6 text-body-secondary mb-2">Browse by month</h2>
                    <div class="dropdown">
                        <button id="events-month-menu" type="button"
                            class="btn btn-outline-secondary d-flex align-items-center justify-content-between gap-2 w-100"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <span><span class="far fa-calendar-alt me-2" aria-hidden="true"></span>{{ isMonthView ? month.date.format('F Y') : 'Upcoming events' }}</span>
                            <span class="fas fa-chevron-down small" aria-hidden="true"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end w-100 sidebar-dropdown-menu" aria-labelledby="events-month-menu">
                            <li>
                                <a href="{{ siteUrl }}demo/events" class="dropdown-item{{ not isMonthView ? ' active' }}"{% if not isMonthView %} aria-current="page"{% endif %}>
                                    Upcoming events
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            {% for date in month.dateRange(6, 6) %}
                                <li>
                                    <a href="{{ siteUrl }}demo/events/{{ date.format('Y/m') }}/{{ date.daysInMonth }}"
                                        class="dropdown-item{{ isMonthView and date == month.date ? ' active' }}"{% if isMonthView and date == month.date %} aria-current="page"{% endif %}>
                                        {{ date.format('F Y') }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </section>
        </div>

    </div>
{% endblock %}
