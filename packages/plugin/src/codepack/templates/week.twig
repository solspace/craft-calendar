{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Week" %}
{% set page = "week" %}

{% block content %}

    {% set targetDate = "today" %}
    {% set calendarHandle = null %}
    {% if segment3 == "calendar" %}
        {% set calendarHandle = segment4 %}
        {% if segment5 %}
            {% set targetDate = segment5~"-"~segment6~"-"~segment7 %}
        {% endif %}
    {% elseif segment3 is not empty %}
        {% set targetDate = segment3~"-"~segment4~"-"~segment5 %}
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-9">

            {% include "demo/layouts/_calendar_banner" %}

            <section id="week_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4">
                {% set week = calendar.week({
                    date: targetDate,
                    calendar: calendarHandle,
                }) %}

                {% set dateBoundsHelper = now.diff(week.nextDate)|date('%r%a') %}

                <div class="row align-items-center g-2 mb-3">
                    <div class="col-6 col-md-3 order-1 order-md-0">
                        {% if dateBoundsHelper > -365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.previousDate.format('Y/m/d') }}">
                                <span class="fas fa-arrow-left" aria-hidden="true"></span> Last Week
                            </a>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6 order-0 text-center">
                        <h1 class="h4 mb-0">
                            Week of {{ week.date.format("F j, Y") }} &nbsp;
                            <span class="badge {{ week.occurrenceCount ? "text-bg-warning" : "text-bg-secondary" }}">
                                {{ week.occurrenceCount }} event{{ week.occurrenceCount > 1 or week.occurrenceCount == 0 ? "s" }}
                            </span>
                        </h1>
                    </div>

                    <div class="col-6 col-md-3 order-2 text-end">
                        {% if dateBoundsHelper < 365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.nextDate.format('Y/m/d') }}">
                                Next Week <span class="fas fa-arrow-right" aria-hidden="true"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                {% for day in week %}
                    <ul class="list-group mb-4">
                        <li class="list-group-item list-group-item-{{ day.dateLocalized.isToday ? "primary" : "secondary" }}">
                            <a class="text-body-emphasis fw-bold" aria-label="{{ day.dateLocalized.isToday ? 'Today, ' }}{{ day.date.format('l, F j, Y') }}"
                                href="{{ siteUrl }}demo/day/{{ segment3 == "calendar" ? segment3~"/"~segment4~"/" }}{{ day.date.format('Y/m/d') }}">
                                {% if day.dateLocalized.isToday %}
                                    TODAY
                                {% else %}
                                    {{ day.date.format('l, F j, Y') }}
                                {% endif %}
                            </a> &nbsp;
                            {% if day.occurrenceCount %}
                                <span class="badge text-bg-warning">
                                    {{ day.occurrenceCount }} event{{ day.occurrenceCount > 1 ? "s" }}
                                </span>
                            {% endif %}
                        </li>
                        <li class="list-group-item">
                            {% if day.occurrences.count %}
                                <ul class="list-group">
                                    {% for occurrence in day.occurrences %}
                                        {% set event = occurrence.event %}
                                        <li class="list-group-item d-flex align-items-center justify-content-between"
                                            style="border-left: 5px solid {{ event.calendar.color }};">
                                            <div>
                                                <span class="far fa-clock"></span>
                                                {% if event.allDay %}
                                                    All Day
                                                {% else %}
                                                    {% if event.multiDay %}
                                                        {% if day.containsDate(occurrence.startDate) %}
                                                            Starts {{ occurrence.startDate.format("g:ia") }}
                                                        {% elseif day.containsDate(occurrence.endDate) %}
                                                            Ends {{ occurrence.endDate.format("g:ia") }}
                                                        {% else %}
                                                            All Day
                                                        {% endif %}
                                                    {% else %}
                                                        {{ occurrence.startDate.format("g:ia") }} - {{ occurrence.endDate.format("g:ia") }}
                                                    {% endif %}
                                                {% endif %}
                                                <b>
                                                    <a href="{{ siteUrl }}demo/event/{{ event.id }}/{{ event.repeating ? occurrence.startDate.format("Y/m/d") }}"
                                                        class="calendar_event_title">
                                                        {{ event.title }}</a>
                                                </b>
                                                {% if event['location'] is defined %}
                                                    &nbsp;&nbsp;<i>{{ event.location }}</i>
                                                {% endif %}
                                            </div>

                                            <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}"
                                                class="badge"
                                                style="background-color: {{ event.calendar.color }}; color: {{ event.calendar.contrastColor }};">
                                                {{ event.calendar.name }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                No events for this day.
                            {% endif %}
                        </li>
                    </ul>
                {% endfor %}
            </section>
        </div>

        <div class="col-lg-3">
            {% include "demo/layouts/_sidebar" %}
        </div>

    </div>

{% endblock %}
