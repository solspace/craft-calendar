{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Week" %}
{% set page = "week" %}

{% block content %}

    {% set targetDate = "today" %}
    {% set calendarHandle = null %}
    {% if segment3 == "calendar" %}
        {% set calendarHandle = segment4 %}
        {% if segment5 %}
            {% set targetDate = segment5~"-"~segment6~"-"~segment7 %}
        {% endif %}
    {% elseif segment3 is not empty %}
        {% set targetDate = segment3~"-"~segment4~"-"~segment5 %}
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-9">

            {% include "demo/layouts/_calendar_banner" %}

            <section id="week_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4">
                {% set week = calendar.week({
                    date: targetDate,
                    calendar: calendarHandle,
                }) %}

                {% set dateBoundsHelper = now.diff(week.nextDate)|date('%r%a') %}

                <div class="row align-items-center g-2 mb-3">
                    <div class="col-6 col-md-3 order-1 order-md-0">
                        {% if dateBoundsHelper > -365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.previousDate.format('Y/m/d') }}">
                                <span class="fas fa-arrow-left" aria-hidden="true"></span> Last Week
                            </a>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6 order-0 text-center">
                        <h1 class="h4 mb-0">
                            Week of {{ week.date.format("F j, Y") }}
                            <span class="badge rounded-pill text-bg-light border text-body-secondary fw-normal fs-6 align-middle ms-1">
                                {{ week.occurrenceCount }} event{{ week.occurrenceCount > 1 or week.occurrenceCount == 0 ? "s" }}
                            </span>
                        </h1>
                    </div>

                    <div class="col-6 col-md-3 order-2 text-end">
                        {% if dateBoundsHelper < 365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.nextDate.format('Y/m/d') }}">
                                Next Week <span class="fas fa-arrow-right" aria-hidden="true"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="border-top">
                    {% for day in week %}
                        <section class="row g-3 align-items-start py-3 px-2 px-md-3{{ day.dateLocalized.isToday ? ' bg-primary-subtle border-start border-primary border-3 rounded-3' }}{{ not loop.last ? ' border-bottom' }}"
                            aria-labelledby="week-day-{{ day.date.format('Y-m-d') }}">
                            <div class="col-sm-4 col-xl-3">
                                <h2 id="week-day-{{ day.date.format('Y-m-d') }}" class="h6 mb-0">
                                    <a class="link-body-emphasis link-underline link-underline-opacity-0 link-underline-opacity-75-hover"
                                        href="{{ siteUrl }}demo/day/{{ segment3 == 'calendar' ? segment3~'/'~segment4~'/' }}{{ day.date.format('Y/m/d') }}"
                                        aria-label="{{ day.dateLocalized.isToday ? 'Today, ' }}{{ day.date.format('l, F j, Y') }}">
                                        <span class="d-block small text-body-secondary fw-normal">{{ day.date.format('l') }}</span>
                                        {{ day.date.format('F j') }}
                                    </a>
                                    {% if day.dateLocalized.isToday %}
                                        <span class="badge rounded-pill text-bg-primary fw-normal ms-1">Today</span>
                                    {% endif %}
                                </h2>
                            </div>
                            <div class="col-sm-8 col-xl-9">
                                {% if day.occurrences.count %}
                                    <ul class="list-unstyled d-grid gap-2 mb-0">
                                        {% for occurrence in day.occurrences %}
                                            {% set event = occurrence.event %}
                                            <li class="d-flex flex-wrap align-items-center justify-content-between gap-2 bg-body rounded-3 border shadow-sm p-3"
                                                style="border-left: 4px solid {{ event.calendar.color }} !important;">
                                                <div>
                                                    <a href="{{ siteUrl }}demo/event/{{ event.id }}/{{ event.repeating ? occurrence.startDate.format('Y/m/d') }}"
                                                        class="fw-semibold link-body-emphasis link-underline link-underline-opacity-0 link-underline-opacity-75-hover">
                                                        {{ event.title }}
                                                    </a>
                                                    <div class="small text-body-secondary mt-1">
                                                        <span class="far fa-clock" aria-hidden="true"></span>
                                                        {% if event.allDay %}
                                                            All day
                                                        {% elseif event.multiDay %}
                                                            {% if day.containsDate(occurrence.startDate) %}
                                                                Starts {{ occurrence.startDate.format('g:ia') }}
                                                            {% elseif day.containsDate(occurrence.endDate) %}
                                                                Ends {{ occurrence.endDate.format('g:ia') }}
                                                            {% else %}
                                                                All day
                                                            {% endif %}
                                                        {% else %}
                                                            {{ occurrence.startDate.format('g:ia') }} – {{ occurrence.endDate.format('g:ia') }}
                                                        {% endif %}
                                                        {% if event['location'] is defined and event.location is not empty %}
                                                            <span class="mx-1" aria-hidden="true">·</span>
                                                            <span class="fas fa-map-marker-alt" aria-hidden="true"></span> {{ event.location|striptags }}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}"
                                                    class="badge rounded-pill text-decoration-none"
                                                    style="background-color: {{ event.calendar.color }}; color: {{ event.calendar.contrastColor }};">
                                                    {{ event.calendar.name }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="small text-body-secondary">No events</span>
                                {% endif %}
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="col-lg-3">
            {% include "demo/layouts/_sidebar" %}
        </div>

    </div>

{% endblock %}
