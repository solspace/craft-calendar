{% extends "demo/tailwind/layouts/_layout" %}

{% set pageTitle = "Calendars" %}
{% set page = "calendars" %}

{% block content %}
    {% set calendars = craft.calendar.calendars({
        handle: segment3 ? segment3 : null,
        orderBy: "name",
        sort: "asc"
    }) %}

    <div class="flex flex-wrap -mx-3 gap-y-6">
        <div class="w-full px-3 lg:w-3/4">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <h1 class="text-2xl font-semibold mb-0">Calendars</h1>
                {% if segment3 %}
                    <a href="{{ siteUrl }}demo/calendars" class="demo-btn demo-btn-outline demo-btn-sm">
                        <span class="fas fa-arrow-left" aria-hidden="true"></span> All calendars
                    </a>
                {% else %}
                    <span class="demo-badge rounded-full bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-500 dark:text-neutral-400 font-normal text-base">
                        {{ calendars|length }} calendar{{ calendars|length == 1 ? '' : 's' }}
                    </span>
                {% endif %}
            </div>

            {% for calendar in calendars %}
                {% set description = calendar.description|striptags|trim %}
                {% set occurrences = craft.calendar.occurrences({
                    rangeStart: 'today',
                    rangeEnd: '+6 months',
                    calendarId: calendar.id,
                    orderBy: {startDate: constant('SORT_ASC')},
                    limit: segment3 ? 20 : 6
                }).all() %}
                {% set visibleOccurrences = segment3 ? occurrences : occurrences|slice(0, 5) %}

                <section class="demo-card calendar-directory-card border-0 rounded-2xl shadow-sm overflow-hidden mb-6"
                    style="--calendar-color: {{ calendar.color }};" aria-labelledby="calendar-heading-{{ calendar.id }}">
                    <div class="demo-card-body p-4 lg:p-6">
                        <div class="flex flex-wrap items-start justify-between gap-4 pb-4 border-b border-neutral-200 dark:border-neutral-700">
                            <div class="flex items-start gap-4">
                                <span class="calendar-directory-icon rounded-lg" aria-hidden="true">
                                    <span class="fas fa-calendar-alt"></span>
                                </span>
                                <div>
                                    <h2 id="calendar-heading-{{ calendar.id }}" class="text-xl font-semibold mb-1">{{ calendar.name }}</h2>
                                    {% if description %}
                                        <p class="text-neutral-500 dark:text-neutral-400 mb-0">{{ description }}</p>
                                    {% endif %}
                                </div>
                            </div>
                            {% if craft.calendar.exportEnabled %}
                                <a href="{{ siteUrl }}demo/export/calendar/{{ calendar.id }}" class="demo-btn demo-btn-outline demo-btn-sm">
                                    <span class="fas fa-file-export" aria-hidden="true"></span> Export events
                                </a>
                            {% endif %}
                        </div>

                        <div class="flex flex-wrap items-center gap-2 sm:gap-4 py-4 border-b border-neutral-200 dark:border-neutral-700">
                            <span class="text-sm text-neutral-500 dark:text-neutral-400">Browse in</span>
                            <div class="demo-btn-group demo-btn-group-sm" role="group" aria-label="Browse {{ calendar.name }} events">
                                <a href="{{ siteUrl }}demo/month/calendar/{{ calendar.handle }}" class="demo-btn demo-btn-outline">Month</a>
                                <a href="{{ siteUrl }}demo/week/calendar/{{ calendar.handle }}" class="demo-btn demo-btn-outline">Week</a>
                                <a href="{{ siteUrl }}demo/day/calendar/{{ calendar.handle }}" class="demo-btn demo-btn-outline">Day</a>
                            </div>
                        </div>

                        {% if craft.calendar.exportEnabled and calendar.icsUrl %}
                            <div class="py-4 border-b border-neutral-200 dark:border-neutral-700">
                                <label class="block mb-2 text-sm font-semibold" for="ics-url-{{ calendar.id }}">Subscribe to this calendar</label>
                                <div class="demo-input-group demo-input-group-sm">
                                    <input id="ics-url-{{ calendar.id }}" type="text" class="demo-input" value="{{ calendar.icsUrl }}" readonly data-select-on-focus>
                                    <a href="{{ calendar.icsUrl }}" class="demo-btn demo-btn-outline" aria-label="Open {{ calendar.name }} subscription URL">
                                        <span class="fas fa-external-link-alt" aria-hidden="true"></span> Open
                                    </a>
                                </div>
                            </div>
                        {% endif %}

                        <div class="pt-4">
                            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                <h3 class="text-base font-semibold mb-0">Upcoming events</h3>
                                <span class="text-sm text-neutral-500 dark:text-neutral-400">Next six months</span>
                            </div>
                            <ul class="list-none p-0 border-t border-neutral-200 dark:border-neutral-700 mb-0">
                                {% include "demo/tailwind/layouts/_calendar_events" with {occurrences: visibleOccurrences} only %}
                            </ul>
                            {% if not segment3 and occurrences|length > 5 %}
                                <a href="{{ siteUrl }}demo/calendars/{{ calendar.handle }}" class="inline-block text-sm mt-4">More upcoming events <span class="fas fa-arrow-right" aria-hidden="true"></span></a>
                            {% endif %}
                        </div>
                    </div>
                </section>
            {% else %}
                <div class="demo-card border-0 rounded-2xl shadow-sm p-6 text-neutral-500 dark:text-neutral-400">
                    No calendars were found.
                </div>
            {% endfor %}
        </div>

        <div class="w-full px-3 lg:w-1/4">
            {% include "demo/tailwind/layouts/_sidebar" %}
        </div>
    </div>
{% endblock %}
