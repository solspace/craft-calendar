{% extends "demo/tailwind/layouts/_layout" %}

{% set pageTitle = "Full Calendar" %}
{% set page = "fullcalendar" %}

{% set allowedCalendars = craft.calendar.allowedCalendars %}
{% set editableCalendars = [] %}
{% set editableCalendarIds = [] %}
{% set canEditAllCalendars = currentUser and (currentUser.admin or currentUser.can('calendar-manageEventsFor:all')) %}

{% if currentUser %}
    {% for calendar in allowedCalendars %}
        {% if canEditAllCalendars or currentUser.can('calendar-manageEventsFor:' ~ calendar.uid) %}
            {% set editableCalendars = editableCalendars|merge([calendar]) %}
            {% set editableCalendarIds = editableCalendarIds|merge([calendar.id]) %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set canCreateEvents = currentUser and editableCalendars|length > 0 %}
{% set calendarOptions = [] %}
{% for calendar in allowedCalendars %}
    {% set calendarOptions = calendarOptions|merge([{
        'id': calendar.id,
        'name': calendar.name,
        'color': calendar.color,
    }]) %}
{% endfor %}

{% set initialView = slug is defined and slug in ['month', 'week', 'day'] ? slug : 'month' %}
{% set initialDate = now|date('Y-m-d') %}
{% if year is defined and month is defined and day is defined %}
    {% set initialDate = [year, '%02d'|format(month), '%02d'|format(day)]|join('-') %}
{% endif %}

{% set calendarConfig = {
    'calendars': calendarOptions,
    'editableCalendarIds': editableCalendarIds,
    'canCreate': canCreateEvents,
    'csrf': {
        'name': craft.app.config.general.csrfTokenName,
        'value': craft.app.request.csrfToken,
    },
    'firstDay': craft.calendar.settings.firstDayOfWeek,
    'initialDate': initialDate,
    'initialView': initialView,
    'locale': craft.app.language,
    'siteId': craft.app.sites.currentSite.id,
    'urls': {
        'editEvent': url('%prefix%/edit/event'),
        'event': url('%prefix%/event'),
        'events': url('%prefix%/resources/event.json'),
        'fullCalendar': url('%prefix%/fullcalendar'),
    },
    'labels': {
        'couldNotCreate': 'Could not save event.'|t,
        'couldNotDelete': 'Could not delete event.'|t,
        'couldNotLoad': 'Could not load events.'|t,
        'couldNotMove': 'Could not move event.'|t,
        'couldNotResize': 'Could not resize event.'|t,
        'day': 'Day'|t,
        'deleteOccurrenceConfirm': 'Are you sure you want to delete only this occurrence?'|t,
        'deleteSeriesConfirm': 'Are you sure you want to delete this event series?'|t,
        'ends': 'Ends:'|t,
        'endsBefore': 'Ends before:'|t,
        'month': 'Month'|t,
        'recurring': 'Recurring event'|t,
        'today': 'Today'|t,
        'week': 'Week'|t,
    },
} %}

{% block headerCss %}
    <link rel="stylesheet" href="{{ siteUrl }}assets/demo/css/full-calendar.css">
{% endblock %}

{% block content %}
    <h1 class="sr-only">Full Calendar</h1>
    <script type="application/json" data-calendar-config>{{ calendarConfig|json_encode(15)|raw }}</script>

    <div id="calendar-errors" class="demo-alert demo-alert-danger calendar-page-error" role="alert" aria-live="assertive" hidden>
        <button type="button" class="demo-close float-right" aria-label="{{ 'Close'|t }}" data-dismiss-calendar-error></button>
        <span data-calendar-error-message></span>
    </div>

    <div class="flex flex-wrap -mx-3">
        <div class="w-full px-3">
            <div id="calendar-wrapper" class="demo-card border-0 rounded-2xl shadow-sm p-4 lg:p-6"></div>
            {% if canCreateEvents %}
                <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-2 mb-0 px-2">
                    <span class="far fa-calendar-plus me-1" aria-hidden="true"></span>
                    {{ 'Select a date or time range to quickly create an event.'|t }}
                </p>
            {% endif %}
            <noscript>
                <div class="demo-alert demo-alert-warning">{{ 'JavaScript is required to display this calendar.'|t }}</div>
            </noscript>
        </div>
    </div>
{% endblock %}

{% block footerJs %}
    <dialog id="event-details-dialog" class="calendar-dialog calendar-dialog--details" aria-labelledby="event-details-title">
        <div class="calendar-dialog__surface">
            <div class="calendar-dialog__header">
                <div class="calendar-dialog__heading">
                    <h2 id="event-details-title" class="calendar-dialog__title" tabindex="-1"></h2>
                    <div class="calendar-data">
                        <span class="color-indicator" data-event-calendar-color aria-hidden="true"></span>
                        <span data-event-calendar-name></span>
                    </div>
                </div>
                <button type="button" class="demo-close" aria-label="{{ 'Close'|t }}" data-close-dialog></button>
            </div>

            <div class="calendar-dialog__body">
                <dl class="event-date-range">
                    <div>
                        <dt>{{ 'Starts:'|t }}</dt>
                        <dd data-event-start></dd>
                    </div>
                    <div>
                        <dt data-event-end-label>{{ 'Ends:'|t }}</dt>
                        <dd data-event-end></dd>
                    </div>
                </dl>
                <div class="event-repeat-rule" data-event-repeat-row hidden>
                    <span class="fas fa-redo text-neutral-500 dark:text-neutral-400" aria-hidden="true"></span>
                    <div>
                        <span class="event-repeat-rule__label">{{ 'Repeats'|t }}</span>
                        <span data-event-repeat></span>
                    </div>
                </div>
                <div class="demo-alert demo-alert-danger calendar-dialog__error" role="alert" aria-live="assertive" data-event-error hidden></div>
            </div>

            <div class="calendar-dialog__actions">
                <div class="relative" data-event-manage-actions hidden>
                    <button class="demo-btn demo-btn-outline demo-dropdown-trigger" type="button" data-demo-dropdown aria-expanded="false">
                        {{ 'More actions'|t }}
                    </button>
                    <ul class="demo-menu">
                        <li><button type="button" class="demo-menu-item text-red-600 dark:text-red-400" data-delete-occurrence>{{ 'Delete Occurrence'|t }}</button></li>
                        <li><button type="button" class="demo-menu-item text-red-600 dark:text-red-400" data-delete-series>{{ 'Delete Series'|t }}</button></li>
                    </ul>
                </div>
                <div class="calendar-dialog__primary-actions">
                    <a class="demo-btn demo-btn-outline" href="#" data-edit-event>{{ 'Edit'|t }}</a>
                    <a class="demo-btn demo-btn-primary" href="#" data-view-event>{{ 'View event'|t }}</a>
                </div>
            </div>
        </div>
    </dialog>

    {% if canCreateEvents %}
        <dialog id="event-creator-dialog" class="calendar-dialog calendar-dialog--creator" aria-labelledby="event-creator-title">
            <form id="event-creator-form">
                <div class="calendar-dialog__surface">
                    <div class="calendar-dialog__header">
                        <h2 id="event-creator-title" class="calendar-dialog__title">{{ 'New Event'|t }}</h2>
                        <button type="button" class="demo-close" aria-label="{{ 'Close'|t }}" data-close-dialog></button>
                    </div>

                    <div class="calendar-dialog__body">
                        <div class="mb-4">
                            <label class="block mb-2" for="event-title">{{ 'Title'|t }}</label>
                            <input id="event-title" class="demo-input" type="text" name="title" autocomplete="off" required>
                        </div>

                        <div class="mb-4">
                            <label class="block mb-2" for="event-calendar">{{ 'Calendar'|t }}</label>
                            <select id="event-calendar" class="demo-select" name="calendarId" required>
                                {% for calendar in editableCalendars %}
                                    <option value="{{ calendar.id }}">{{ calendar.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="demo-check mb-4">
                            <input id="event-all-day" class="demo-checkbox" type="checkbox" name="allDay" value="1">
                            <label class="cursor-pointer" for="event-all-day">{{ 'All Day'|t }}</label>
                        </div>

                        <div data-all-day-fields hidden>
                            <div class="mb-4">
                                <label class="block mb-2" for="event-start-date">{{ 'Start Date'|t }}</label>
                                <input id="event-start-date" class="demo-input" type="date" name="startDate">
                            </div>
                            <div class="mb-4">
                                <label class="block mb-2" for="event-end-date">{{ 'End Date (exclusive)'|t }}</label>
                                <input id="event-end-date" class="demo-input" type="date" name="endDate">
                                <small class="demo-help text-neutral-500 dark:text-neutral-400">
                                    {{ 'All-day events end at midnight before this date.'|t }}
                                </small>
                            </div>
                        </div>

                        <div data-timed-fields>
                            <div class="mb-4">
                                <label class="block mb-2" for="event-start-datetime">{{ 'Starts'|t }}</label>
                                <input id="event-start-datetime" class="demo-input" type="datetime-local" name="startDateTime" step="60">
                            </div>
                            <div class="mb-4">
                                <label class="block mb-2" for="event-end-datetime">{{ 'Ends'|t }}</label>
                                <input id="event-end-datetime" class="demo-input" type="datetime-local" name="endDateTime" step="60">
                            </div>
                        </div>

                        <div class="demo-alert demo-alert-danger calendar-dialog__error" role="alert" aria-live="assertive" data-create-error hidden></div>
                    </div>

                    <div class="calendar-dialog__actions">
                        <button type="button" class="demo-btn demo-btn-outline" data-close-dialog>{{ 'Cancel'|t }}</button>
                        <button type="submit" class="demo-btn demo-btn-primary" data-create-submit>{{ 'Save'|t }}</button>
                    </div>
                </div>
            </form>
        </dialog>
    {% endif %}

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.19/locales-all.global.min.js"></script>
    <script src="{{ siteUrl }}assets/demo/js/full-calendar.js"></script>
{% endblock %}
