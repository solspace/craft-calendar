{% extends "demo/tailwind/layouts/_layout" %}

{% set pageTitle = "Events List" %}
{% set page = "events" %}

{% macro pager(pageInfo) %}
    {% if pageInfo.totalPages > 1 %}
        <nav aria-label="Events pages">
            <ul class="demo-pagination flex-wrap mb-0">
                {% if pageInfo.prevUrl %}
                    <li class="demo-page-item">
                        <a class="demo-page-link" href="{{ pageInfo.prevUrl }}">&laquo; Previous</a>
                    </li>
                {% endif %}

                {% for page, url in pageInfo.getPrevUrls(3) %}
                    <li class="demo-page-item">
                        <a class="demo-page-link" href="{{ url }}">{{ page }}</a>
                    </li>
                {% endfor %}

                <li class="demo-page-item active" aria-current="page">
                    <span class="demo-page-link">{{ pageInfo.currentPage }}</span>
                </li>

                {% for page, url in pageInfo.getNextUrls(3) %}
                    <li class="demo-page-item">
                        <a class="demo-page-link" href="{{ url }}">{{ page }}</a>
                    </li>
                {% endfor %}

                {% if pageInfo.nextUrl %}
                    <li class="demo-page-item">
                        <a class="demo-page-link" href="{{ pageInfo.nextUrl }}">Next &raquo;</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}
{% endmacro %}
{% from _self import pager %}

{% block content %}

    {% set isMonthView = segment3 and segment4 and segment5 %}
    {% if isMonthView %}
        {% set targetStartDate = segment3 ~ '-' ~ segment4 ~ '-01' %}
        {% set targetEndDate = segment3 ~ '-' ~ segment4 ~ '-' ~ segment5 %}
    {% else %}
        {% set targetStartDate = 'today' %}
        {% set targetEndDate = '+30 days' %}
    {% endif %}

    <div class="flex flex-wrap -mx-3 gap-y-6">
        <div class="w-full px-3 lg:w-3/4">

            {% set eventOptions = {
                rangeStart: targetStartDate,
                rangeEnd: targetEndDate,
                limit: 15,
                orderBy: {startDate: constant('SORT_ASC')}
            } %}

            {% paginate calendar.occurrences(eventOptions) as pageInfo, occurrences %}

            <section id="events_calendar" class="demo-card border-0 rounded-2xl shadow-sm p-4 lg:p-6" aria-labelledby="events-heading">
                <h1 id="events-heading" class="text-2xl font-semibold mb-4 flex flex-wrap items-center gap-2">
                    <span>{{ isMonthView ? targetStartDate|date('F Y') : 'Upcoming Events' }}</span>
                    <span class="demo-badge rounded-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-normal text-base">
                        {{ pageInfo.total }} event{{ pageInfo.total == 1 ? '' : 's' }}
                    </span>
                </h1>

                <ul class="list-none p-0 border-t border-slate-200 dark:border-slate-700 mb-0">
                    {% for occurrence in occurrences %}
                        {% set event = occurrence.event %}
                        <li class="flex flex-col sm:flex-row items-start gap-2 sm:gap-4 py-4 px-2 md:px-4{{ not loop.first ? ' border-t border-slate-200 dark:border-slate-700' }}">
                            <div class="events-date sm:pt-1">
                                <a class="inline-flex items-center gap-2 text-slate-900 dark:text-slate-100 no-underline hover:underline focus-visible:underline"
                                    href="{{ siteUrl }}demo/day/{{ occurrence.startDate.format('Y/m/d') }}"
                                    aria-label="{{ occurrence.startDate.format('l, F j, Y') }}">
                                    <time class="inline-flex items-center gap-2" datetime="{{ occurrence.startDate.format('Y-m-d') }}">
                                        <span class="text-3xl leading-none">{{ occurrence.startDate.format('j') }}</span>
                                        <span class="inline-flex flex-col text-sm leading-tight">
                                            <span>{{ occurrence.startDate.format('D') }}</span>
                                            <span class="text-slate-500 dark:text-slate-400">{{ occurrence.startDate.format('M') }}</span>
                                        </span>
                                    </time>
                                </a>
                            </div>
                            <article class="calendar-agenda-event relative grow bg-slate-50 dark:bg-slate-800 rounded-lg px-4 py-2"
                                style="--calendar-color: {{ event.calendar.color }};">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <h2 class="text-base font-semibold mb-1">
                                            <a href="{{ siteUrl }}demo/event/{{ event.id }}{% if event.repeats() or event.rrule is not empty %}/{{ occurrence.startDate.format('Y/m/d') }}{% endif %}"
                                                class="text-slate-900 dark:text-slate-100 no-underline hover:underline focus-visible:underline">
                                                {{ event.title }}
                                            </a>
                                        </h2>
                                        <div class="text-sm text-slate-500 dark:text-slate-400">
                                            <span class="far fa-clock" aria-hidden="true"></span>
                                            {% if event.allDay %}
                                                All day
                                            {% elseif event.multiDay %}
                                                {{ occurrence.startDate.format('g:ia') }} – {{ occurrence.endDate.format('M j, g:ia') }}
                                            {% else %}
                                                {{ occurrence.startDate.format('g:ia') }} – {{ occurrence.endDate.format('g:ia') }}
                                            {% endif %}
                                            {% if event['location'] is defined and event.location is not empty %}
                                                <span class="mx-1" aria-hidden="true">·</span>
                                                <span class="fas fa-map-marker-alt" aria-hidden="true"></span> {{ event.location|striptags }}
                                            {% endif %}
                                        </div>
                                    </div>
                                    <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}"
                                        class="demo-badge rounded-full bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 border border-slate-200 dark:border-slate-700 no-underline font-normal">
                                        <span class="fas fa-calendar-alt calendar-color-icon me-1" aria-hidden="true"></span>
                                        {{ event.calendar.name }}
                                    </a>
                                </div>
                                {% if event['description'] is defined and event.description is not empty %}
                                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2 mb-0">{{ event.description|striptags }}</p>
                                {% endif %}
                            </article>
                        </li>
                    {% else %}
                        <li class="text-center text-slate-500 dark:text-slate-400 py-6">
                            {{ isMonthView ? 'No events found for this month.' : 'No events scheduled over the next 30 days.' }}
                        </li>
                    {% endfor %}
                </ul>

                {% if pageInfo.totalPages > 1 %}
                    <div class="border-t border-slate-200 dark:border-slate-700 pt-4">
                        {{ pager(pageInfo) }}
                    </div>
                {% endif %}
            </section>
        </div>

        <div class="w-full px-3 lg:w-1/4">
            {% include "demo/tailwind/layouts/_sidebar" %}
            <section class="demo-card border-0 rounded-2xl shadow-sm mt-6">
                <div class="demo-card-body">
                    {% set month = craft.calendar.month({date: targetStartDate, calendarId: 0}) %}
                    <h2 class="text-base font-semibold text-slate-500 dark:text-slate-400 mb-2">Browse by month</h2>
                    <div class="relative">
                        <button id="events-month-menu" type="button"
                            class="demo-btn demo-btn-outline flex items-center justify-between gap-2 w-full"
                            data-demo-dropdown aria-expanded="false">
                            <span><span class="far fa-calendar-alt me-2" aria-hidden="true"></span>{{ isMonthView ? month.date.format('F Y') : 'Upcoming events' }}</span>
                            <span class="fas fa-chevron-down text-sm" aria-hidden="true"></span>
                        </button>
                        <ul class="demo-menu right-0 left-auto w-full sidebar-dropdown-menu" aria-labelledby="events-month-menu">
                            <li>
                                <a href="{{ siteUrl }}demo/events" class="demo-menu-item{{ not isMonthView ? ' active' }}"{% if not isMonthView %} aria-current="page"{% endif %}>
                                    Upcoming events
                                </a>
                            </li>
                            <li><hr class="demo-menu-divider"></li>
                            {% for date in month.dateRange(6, 6) %}
                                <li>
                                    <a href="{{ siteUrl }}demo/events/{{ date.format('Y/m') }}/{{ date.daysInMonth }}"
                                        class="demo-menu-item{{ isMonthView and date == month.date ? ' active' }}"{% if isMonthView and date == month.date %} aria-current="page"{% endif %}>
                                        {{ date.format('F Y') }}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </section>
        </div>

    </div>
{% endblock %}
