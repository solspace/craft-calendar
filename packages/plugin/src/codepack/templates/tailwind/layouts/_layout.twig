<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Demo Templates for Calendar">
    <meta name="author" content="Solspace">
    <title>Calendar Demo | {{ pageTitle ? pageTitle : "Home" }}</title>
    <meta name="theme-color" content="#ffffff">
    <script src="{{ siteUrl }}assets/demo/js/theme.js?v=2"></script>
    <script src="{{ siteUrl }}assets/demo/js/framework.js"></script>
    <link href="https://use.fontawesome.com/releases/v5.2.0/css/all.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ siteUrl }}assets/demo/css/tailwind.css?v=5">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/demo/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/demo/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/demo/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/demo/favicon/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    {% block headerCss %}{% endblock %}
</head>

{# Acquire URL segments #}
{% set segment1 = craft.app.request.segment(1) %}
{% set segment2 = craft.app.request.segment(2) %}
{% set segment3 = craft.app.request.segment(3) %}
{% set segment4 = craft.app.request.segment(4) %}
{% set segment5 = craft.app.request.segment(5) %}
{% set segment6 = craft.app.request.segment(6) %}
{% set segment7 = craft.app.request.segment(7) %}

<body id="top" class="bg-neutral-50 dark:bg-neutral-800">
<a class="demo-skip-link absolute bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 p-2" href="#main-content">Skip to main content</a>

{% if page is not defined %}
    {% set page = "month" %}
{% endif %}

<nav class="demo-navbar bg-neutral-900 fixed inset-x-0 top-0 z-50 shadow-sm" aria-label="Main navigation">
    <div class="mx-auto w-full max-w-7xl px-4 lg:px-6">
        <a class="demo-brand inline-flex items-center gap-2" href="{{ siteUrl }}demo/">
            <img src="{{ siteUrl }}assets/demo/images/icon.svg" alt="" width="30" height="30">
            <span>Calendar Demo</span>
        </a>
        <button class="demo-nav-toggle" type="button" data-nav-toggle aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="demo-nav-toggle-icon"></span>
        </button>
        <div class="demo-nav-panel" id="navbarSupportedContent">
            <ul class="demo-nav-items me-auto xl:gap-1">
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'month' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/month"{% if page == 'month' %} aria-current="page"{% endif %}>Month</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'week' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/week"{% if page == 'week' %} aria-current="page"{% endif %}>Week</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'day' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/day"{% if page == 'day' %} aria-current="page"{% endif %}>Day</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'events' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/events"{% if page == 'events' %} aria-current="page"{% endif %}>Events List</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'calendars' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/calendars"{% if page == 'calendars' %} aria-current="page"{% endif %}>Calendars</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'fullcalendar' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/fullcalendar"{% if page == 'fullcalendar' %} aria-current="page"{% endif %}>Full Calendar</a>
                </li>
                <li>
                    <a class="demo-nav-link px-2 rounded-md{{ page == 'edit' ? ' active bg-white/10' }}" href="{{ siteUrl }}demo/edit/event/new"{% if page == 'edit' %} aria-current="page"{% endif %}>Create</a>
                </li>
            </ul>
            <div class="demo-nav-items relative">
                <a class="demo-nav-link demo-dropdown-trigger" href="#" id="navbarDropdown" role="button"
                    data-demo-dropdown aria-expanded="false">
                    Resources
                </a>
                <div class="demo-menu right-0 left-auto" aria-labelledby="navbarDropdown">
                    <a class="demo-menu-item" href="https://plugins.craftcms.com/calendar">Plugin Store</a>
                    <a class="demo-menu-item" href="https://docs.solspace.com/craft/calendar/v6/">Documentation</a>
                    <a class="demo-menu-item" href="https://docs.solspace.com/support/">Support</a>
                </div>
            </div>
            <div class="xl:ms-2 mt-2 xl:mt-0">
                <label class="sr-only" for="framework-select">CSS framework</label>
                <select id="framework-select" class="demo-select demo-input-sm demo-nav-select" data-framework-select aria-label="CSS framework">
                    <option value="tailwind">Tailwind 4</option>
                    <option value="bootstrap">Bootstrap 5</option>
                </select>
            </div>
            <div class="xl:ms-2 mt-2 xl:mt-0">
                <label class="sr-only" for="theme-select">Color mode</label>
                <select id="theme-select" class="demo-select demo-input-sm demo-nav-select" data-theme-select>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                    <option value="auto" selected>Auto</option>
                </select>
            </div>
        </div>
    </div>
</nav>

<main id="main-content" class="mx-auto w-full max-w-7xl px-4 py-4 pb-12" tabindex="-1">
    {% block content %}{% endblock %}
</main>

<footer class="bg-neutral-50 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 py-6 mt-12">
    <div class="mx-auto w-full max-w-7xl px-4">
        <p class="float-right mb-0">
            <a href="#top">Back to top</a>
        </p>
        <p class="mb-0"><a href="https://docs.solspace.com/craft/calendar/v6/">Calendar</a> for Craft CMS. &copy; 2010-{{ "now"|date("Y") }} <a href="https://solspace.com">Solspace, Inc.</a></p>
    </div>
</footer>

<script src="{{ siteUrl }}assets/demo/js/main.js"></script>

{% block footerJs %}{% endblock %}
</body>
</html>
