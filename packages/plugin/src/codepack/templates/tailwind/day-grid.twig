{% extends "demo/tailwind/layouts/_layout" %}

{% set pageTitle = "Day" %}
{% set page = "day" %}

{% block headerCss %}
    <link rel="stylesheet" href="{{ siteUrl }}assets/demo/css/week-grid.css?v=3">
{% endblock %}

{% block content %}
    {% set targetDate = segment3 == 'calendar' and segment5 ? segment5 ~ '-' ~ segment6 ~ '-' ~ segment7 : (segment3 and segment3 != 'calendar' ? segment3 ~ '-' ~ segment4 ~ '-' ~ segment5 : 'today') %}
    {% set calendarHandle = segment3 == 'calendar' ? segment4 : null %}
    {% set targetDate = craft.app.request.getQueryParam('date') ?: targetDate %}
    {% set calendarHandle = craft.app.request.getQueryParam('calendar') ?: calendarHandle %}

    {% set day = craft.calendar.day({date: targetDate, calendar: calendarHandle}) %}
    {% set dateBoundsHelper = now.diff(day.nextDate)|date('%r%a') %}

    <section class="rounded-2xl bg-white shadow-sm dark:bg-neutral-900/50 p-4 lg:p-6" aria-labelledby="day-grid-title">
        <div class="flex flex-wrap -mx-3 items-center gap-y-2 mb-4">
            <div class="w-1/2 px-3 md:w-1/4 order-1 md:order-0">
                {% if dateBoundsHelper > -365 %}
                    <a class="demo-btn demo-btn-outline demo-btn-sm" href="{{ siteUrl }}demo/day?framework=tailwind&amp;date={{ day.previousDate.format('Y-m-d') }}{% if calendarHandle %}&amp;calendar={{ calendarHandle|url_encode }}{% endif %}">
                        <span class="fas fa-arrow-left" aria-hidden="true"></span> Previous Day
                    </a>
                {% endif %}
            </div>
            <div class="w-full px-3 md:w-1/2 order-0 text-center">
                <h1 id="day-grid-title" class="text-2xl font-semibold mb-0">{{ day.date.format('l, F j, Y') }}</h1>
                <span class="text-sm text-neutral-500 dark:text-neutral-400">Hourly view · {{ day.occurrenceCount }} event{{ day.occurrenceCount == 1 ? '' : 's' }}</span>
            </div>
            <div class="w-1/2 px-3 md:w-1/4 order-2 text-right">
                {% if dateBoundsHelper < 365 %}
                    <a class="demo-btn demo-btn-outline demo-btn-sm" href="{{ siteUrl }}demo/day?framework=tailwind&amp;date={{ day.nextDate.format('Y-m-d') }}{% if calendarHandle %}&amp;calendar={{ calendarHandle|url_encode }}{% endif %}">
                        Next Day <span class="fas fa-arrow-right" aria-hidden="true"></span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-end gap-2 mb-4">
            <span class="text-sm text-neutral-500 dark:text-neutral-400 me-auto">Overlapping events appear side by side.</span>
            {% include "demo/tailwind/layouts/_view_switch" with {viewType: 'day', activeView: 'grid', date: day.date, calendarHandle: calendarHandle} %}
        </div>

        {% include "demo/tailwind/layouts/_hour_grid" with {gridDays: [day], gridMode: 'day', calendarHandle: calendarHandle} %}
    </section>
{% endblock %}

{% block footerJs %}
    <script src="{{ siteUrl }}assets/demo/js/week-grid.js?v=1"></script>
{% endblock %}
