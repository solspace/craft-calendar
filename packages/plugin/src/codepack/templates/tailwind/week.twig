{% extends "demo/tailwind/layouts/_layout" %}

{% set pageTitle = "Week" %}
{% set page = "week" %}

{% block content %}

    {% set targetDate = "today" %}
    {% set calendarHandle = null %}
    {% if segment3 == "calendar" %}
        {% set calendarHandle = segment4 %}
        {% if segment5 %}
            {% set targetDate = segment5~"-"~segment6~"-"~segment7 %}
        {% endif %}
    {% elseif segment3 is not empty %}
        {% set targetDate = segment3~"-"~segment4~"-"~segment5 %}
    {% endif %}

    <div class="flex flex-wrap -mx-3 gap-y-6">
        <div class="w-full px-3 lg:w-3/4">

            <section id="week_calendar" class="demo-card border-0 rounded-2xl shadow-sm p-4 lg:p-6">
                {% set week = calendar.week({
                    date: targetDate,
                    calendar: calendarHandle,
                }) %}

                {% set dateBoundsHelper = now.diff(week.nextDate)|date('%r%a') %}

                <div class="flex flex-wrap -mx-3 items-center gap-y-2 mb-4">
                    <div class="w-1/2 px-3 md:w-1/4 order-1 md:order-0">
                        {% if dateBoundsHelper > -365 %}
                            <a class="demo-btn demo-btn-outline demo-btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.previousDate.format('Y/m/d') }}">
                                <span class="fas fa-arrow-left" aria-hidden="true"></span> Last Week
                            </a>
                        {% endif %}
                    </div>

                    <div class="w-full px-3 md:w-1/2 order-0 text-center">
                        <h1 class="text-2xl font-semibold mb-0 flex flex-wrap items-center justify-center gap-2">
                            <span>Week of {{ week.date.format("F j, Y") }}</span>
                            <span class="demo-badge rounded-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-normal text-base">
                                {{ week.occurrenceCount }} event{{ week.occurrenceCount > 1 or week.occurrenceCount == 0 ? "s" }}
                            </span>
                            {% include "demo/tailwind/layouts/_calendar_banner" with {calendarHandle: calendarHandle, view: 'week', date: week.date} %}
                        </h1>
                    </div>

                    <div class="w-1/2 px-3 md:w-1/4 order-2 text-right">
                        {% if dateBoundsHelper < 365 %}
                            <a class="demo-btn demo-btn-outline demo-btn-sm"
                                href="{{ siteUrl }}demo/week/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ week.nextDate.format('Y/m/d') }}">
                                Next Week <span class="fas fa-arrow-right" aria-hidden="true"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="border-t border-slate-200 dark:border-slate-700">
                    {% for day in week %}
                        <section class="flex flex-col sm:flex-row items-start gap-2 sm:gap-4 py-2 px-2 md:px-4{{ day.dateLocalized.isToday ? ' bg-blue-50 dark:bg-blue-950' }}{{ not loop.first and not day.dateLocalized.isToday ? ' border-t border-slate-200 dark:border-slate-700' }}"
                            aria-labelledby="week-day-{{ day.date.format('Y-m-d') }}">
                            <div class="week-date sm:pt-2">
                                <h2 id="week-day-{{ day.date.format('Y-m-d') }}" class="text-base font-semibold mb-0">
                                    <a class="inline-flex items-center gap-2 text-slate-900 dark:text-slate-100 no-underline hover:underline focus-visible:underline"
                                        href="{{ siteUrl }}demo/day/{{ segment3 == 'calendar' ? segment3~'/'~segment4~'/' }}{{ day.date.format('Y/m/d') }}"
                                        aria-label="{{ day.dateLocalized.isToday ? 'Today, ' }}{{ day.date.format('l, F j, Y') }}">
                                        <span class="text-3xl leading-none">{{ day.date.format('j') }}</span>
                                        <span class="inline-flex flex-col text-sm leading-tight font-normal">
                                            <span>{{ day.date.format('D') }}</span>
                                            <span class="text-slate-500 dark:text-slate-400">{{ day.date.format('M') }}</span>
                                        </span>
                                    </a>
                                    {% if day.dateLocalized.isToday %}
                                        <span class="demo-badge rounded-full bg-blue-600 text-white font-normal text-base align-middle ms-1">Today</span>
                                    {% endif %}
                                </h2>
                            </div>
                            <div class="week-events grow self-stretch">
                                {% if day.occurrences.count %}
                                    <ul class="list-none p-0 grid gap-2 mb-0">
                                        {% for occurrence in day.occurrences %}
                                            {% include "demo/tailwind/layouts/_agenda_event" %}
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="inline-block sm:pt-2 text-sm text-slate-500 dark:text-slate-400">No events</span>
                                {% endif %}
                            </div>
                        </section>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="w-full px-3 lg:w-1/4">
            {% include "demo/tailwind/layouts/_sidebar" %}
        </div>

    </div>

{% endblock %}
