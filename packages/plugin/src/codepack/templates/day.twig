{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Day" %}
{% set page = "day" %}

{% block content %}

    {% set targetDate = "today" %}
    {% set calendarHandle = null %}
    {% if segment3 == "calendar" %}
        {% set calendarHandle = segment4 %}
        {% if segment5 %}
            {% set targetDate = segment5~"-"~segment6~"-"~segment7 %}
        {% endif %}
    {% elseif segment3 is not empty %}
        {% set targetDate = segment3~"-"~segment4~"-"~segment5 %}
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-9">

            {% include "demo/layouts/_calendar_banner" %}

            {% set day = craft.calendar.day({
                date: targetDate,
                calendar: calendarHandle,
            }) %}

            {% set dateBoundsHelper = now.diff(day.nextDate)|date('%r%a') %}

            <section id="day_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4">

                <div class="row align-items-center g-2 mb-3">
                    <div class="col-6 col-md-3 order-1 order-md-0">
                        {% if dateBoundsHelper > -365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/day/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ day.previousDate.format('Y/m/d') }}">
                                <span class="fas fa-arrow-left" aria-hidden="true"></span> Previous
                            </a>
                        {% endif %}
                    </div>

                    <div class="col-12 col-md-6 order-0 text-center">
                        <h1 class="h4 mb-0">
                            {{ day.date.format('l, F j, Y') }}
                            {% if day.dateLocalized.isToday %}
                                <span class="badge text-bg-primary align-middle fs-6">Today</span>
                            {% endif %}
                            <span class="badge {{ day.occurrenceCount ? "text-bg-warning" : "text-bg-secondary" }}">
                                {{ day.occurrenceCount }} event{{ day.occurrenceCount > 1 or day.occurrenceCount == 0 ? "s" }}
                            </span>
                        </h1>
                    </div>

                    <div class="col-6 col-md-3 order-2 text-end">
                        {% if dateBoundsHelper < 365 %}
                            <a class="btn btn-outline-secondary btn-sm"
                                href="{{ siteUrl }}demo/day/{{ segment3 == "calendar" ? "calendar/"~segment4~"/" }}{{ day.nextDate.format('Y/m/d') }}">
                                Next <span class="fas fa-arrow-right" aria-hidden="true"></span>
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <caption class="visually-hidden">Events for {{ day.date.format('F j, Y') }}</caption>
                        <tbody>
                            <tr>
                                    <th scope="row" style="width: 15%;">
                                    {% if day.allDayOccurrenceCount %}
                                        <strong>All Day</strong>
                                        <span class="badge text-bg-warning float-end">
                                            {{ day.allDayOccurrenceCount }}
                                        </span>
                                    {% else %}
                                        All Day
                                    {% endif %}
                                </th>
                                <td>
                                    {% if day.allDayOccurrences %}
                                        <ul class="list-group">
                                            {% for occurrence in day.allDayOccurrences %}
                                                {% set event = occurrence.event %}
                                                <li class="list-group-item d-flex align-items-center justify-content-between"
                                                    style="background-color: {{ event.calendar.lighterColor }}; border-left: 5px solid {{ event.calendar.color }};">
                                                    <div>
                                                        <b>
                                                            <a href="{{ siteUrl }}demo/event/{{ event.id }}/{{ event.repeating ? occurrence.startDate.format('Y/m/d') }}"
                                                                style="color: {{ event.calendar.contrastColor }} !important;">
                                                                {{ event.title }}</a>
                                                        </b>

                                                        {% if event['location'] is defined %}
                                                            &nbsp;&nbsp;<i>{{ event.location }}</i>
                                                        {% endif %}
                                                    </div>

                                                    <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}/"
                                                        class="badge"
                                                        style="background-color: {{ event.calendar.color }}; color: {{ event.calendar.contrastColor }};">
                                                        {{ event.calendar.name }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </td>
                            </tr>

                            {% for hour in day %}
                                <tr>
                                    <th scope="row">
                                        {% if hour.occurrenceCount %}
                                            <strong>{{ hour.date.format('g a') }}</strong>
                                            <span class="badge text-bg-warning float-end">
                                                {{ hour.occurrenceCount }}
                                            </span>
                                        {% else %}
                                            {{ hour.date.format('g a') }}
                                        {% endif %}
                                    </th>
                                    <td>
                                        {% if hour.occurrences.count %}
                                            <ul class="list-group">
                                                {% for occurrence in hour.occurrences %}
                                                    {% set event = occurrence.event %}

                                                    <li class="list-group-item d-flex align-items-center justify-content-between"
                                                        style="border-left: 5px solid {{ event.calendar.color }};">
                                                        <div>
                                                            <span class="far fa-clock"></span>

                                                            {% if event.multiDay %}
                                                                {% if day.containsDate(occurrence.startDate) %}
                                                                    Starts {{ occurrence.startDate.format('g:ia') }} ({{ event.duration.humanReadable }})
                                                                {% elseif day.containsDate(occurrence.endDate) %}
                                                                    Ends {{ occurrence.endDate.format('g:ia') }} ({{ event.duration.humanReadable }})
                                                                {% endif %}
                                                            {% else %}
                                                                {{ occurrence.startDate.format('g:ia') }} - {{ occurrence.endDate.format('g:ia') }}
                                                            {% endif %}
                                                            &nbsp;
                                                            <b>
                                                                <a href="{{ siteUrl }}demo/event/{{ event.id }}/{{ event.repeating ? occurrence.startDate.format('Y/m/d') }}"
                                                                    class="calendar_event_title">
                                                                    {{ event.title }}
                                                                </a>
                                                            </b>

                                                            {% if event['location'] is defined %}
                                                                <i>{{ event.location }}</i>
                                                            {% endif %}
                                                        </div>

                                                        <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}/"
                                                            class="badge"
                                                            style="background-color: {{ event.calendar.color }}; color: {{ event.calendar.contrastColor }};">
                                                            {{ event.calendar.name }}
                                                        </a>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <div class="col-lg-3">
            {% include "demo/layouts/_sidebar" %}
        </div>

    </div>

{% endblock %}
