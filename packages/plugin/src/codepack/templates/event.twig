{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Event" %}
{% set page = "event" %}

{% block content %}

	<h1>Event View</h1>
	<p class="lead">
		Below is an individual event view, which allows you to see full details and occurrences for the given event.
	</p>
    <hr /><br />

    {% set eventSaved = craft.app.session.getFlash('calendar_event_saved') %}
    {% if eventSaved %}
        <div class="alert alert-success alert-dismissible" role="alert">
            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            Event saved successfully!
        </div>
		<br />
    {% endif %}

	<div class="row">
		<div class="col-md-9">
			<div id="events_calendar">

                {% set occurrenceDate = null %}
                {% if segment4 and segment5 and segment6 %}
                    {% set occurrenceDate = segment4~"-"~segment5~"-"~segment6 %}
                {% endif %}

                {% if event is not defined %}
                    {% set event = craft.calendar.events({
                        id: segment3,
                        status: null,
                    }).one() %}
                {% endif %}

                {% if event %}
                    {% set occurrence = null %}
                    {% if occurrenceDate %}
                        {% set occurrence = craft.calendar.occurrences({
                            event: event.id,
                            rangeStart: occurrenceDate,
                            rangeEnd: occurrenceDate ~ " 23:59:59",
                            status: null,
                        }).one() %}
                    {% endif %}

                    {% set displayStartDate = occurrence ? occurrence.startDate : event.startDate %}
                    {% set displayEndDate = occurrence ? occurrence.endDate : event.endDate %}
                    {% set displayAllDay = occurrence ? occurrence.allDay : event.allDay %}
                    {% set displayMultiDay = displayStartDate.format('Y-m-d') != displayEndDate.format('Y-m-d') %}

                    <div class="btn-group float-right" role="group" aria-label="actions">
                        {% if craft.calendar.exportEnabled %}
                            <a href="{{ siteUrl }}demo/export/event/{{ segment3 }}"
                               class="btn btn-primary btn-sm"
                               role="button">
                                <span class="fas fa-file-export" aria-hidden="true"></span>
                                &nbsp;Export Event
                            </a>
                        {% endif %}

                        {% if craft.calendar.canEditEvent(event) %}
                            <a href="{{ siteUrl }}demo/edit/event/{{ segment3 }}"
                               class="btn btn-warning btn-sm"
                               role="button">
                                <span class="fas fa-edit"></span>
                                &nbsp;Edit
                            </a>
                        {% endif %}
                    </div>

                    <h3>{{ event.title }}</h3>

                    <table class="table table-striped mt-3">
                        <tr>
                            <th style="width: 20%;">Calendar</th>
                            <td>
                                <span class="fas fa-calendar-alt" style="color: {{ event.calendar.color }};"></span>&nbsp;
                                <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}" style="color: {{ event.calendar.color }};">
                                    {{ event.calendar.name }}
                                </a>
                            </td>
                        </tr>
                        {% if event['location'] is defined and event.location is not empty %}
                            <tr>
                                <th>Location</th>
                                <td>
                                    {{ event.location }}
                                </td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th>Date</th>
                            <td>
                                {{ displayStartDate.format('l, F j, Y') }}

                                {% if displayAllDay %}
                                    (all day)
                                {% else %}
                                    at {{ displayStartDate.format("g:ia") }} -
                                    {% if displayMultiDay %}
                                        <br />{{ displayEndDate.format("l, F j, Y \\a\\t g:ia") }}
                                    {% else %}
                                        {{ displayEndDate.format("g:ia") }}
                                    {% endif %}
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>Duration</th>
                            <td>
                                <span class="far fa-clock"></span>&nbsp;
                                {{ event.duration.humanReadable }}
                            </td>
                        </tr>
                        {% if event['description'] is defined and event.description is not empty %}
                            <tr>
                                <th>Details</th>
                                <td>{{ event.description }}</td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th>Repeats?</th>
                            <td>
                                {% if event.repeating %}
                                    <span class="fas fa-redo"></span>&nbsp;
                                    Repeats {{ event.readableRepeatRule }}
                                {% else %}
                                    No
                                {% endif %}
                            </td>
                        </tr>

                        {% if event.repeating %}
                        <tr>
                            <th>Upcoming Recurrences</th>
                            <td>
                                {% set occurrences = craft.calendar.occurrences({
                                    event: event.id,
                                    rangeStart: 'today',
                                    rangeEnd: '+6 months',
                                    limit: 10,
                                    status: null,
                                }).all() %}

                                {% if occurrences %}
                                    <ul class="list-group">
                                        {% for occurrence in occurrences %}
                                            {% set occurrenceMultiDay = occurrence.startDate.format('Y-m-d') != occurrence.endDate.format('Y-m-d') %}
                                            <li class="list-group-item d-flex align-items-center" style="border-left: 5px solid {{ occurrence.calendar.color }};">
                                                <small class="mr-auto">
                                                    <span class="far fa-clock"></span>&nbsp;
                                                    {{ occurrence.startDate.format("l, F j, Y") }}

                                                    {% if occurrence.allDay %}
                                                        (all day)
                                                    {% else %}
                                                        at {{ occurrence.startDate.format("g:ia") }}
                                                        {% if occurrenceMultiDay %}
                                                            <br />{{ occurrence.endDate.format("l, F j, Y \\a\\t g:ia") }}
                                                        {% else %}
                                                            {{ occurrence.endDate.format("g:ia") }}
                                                        {% endif %}
                                                    {% endif %}
                                                </small>

                                                <a href="{{ siteUrl }}demo/event/{{ occurrence.event.id }}/{{ occurrence.startDate.format("Y/m/d") }}" class="badge mr-2"
                                                   style="background-color: {{ occurrence.calendar.color }}; color: {{ occurrence.calendar.contrastColor }} !important;">
                                                    View Recurrence
                                                </a>
                                                <a class="badge badge-primary"
                                                   href="{{ siteUrl }}demo/day/{{ occurrence.startDate.format("Y/m/d") }}">
                                                    View Day in Calendar
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p>No occurrences found for this timeframe (next 6 months from today).</p>
                                {% endif %}
                            </td>
                        </tr>
                        {% endif %}
                    </table>

                {% else %}
                    <div class="alert alert-danger" role="alert">
                        <p class="lead">
                            Sorry, no event was found.
                        </p>
                    </div>
                {% endif %}
			</div>

		</div>

		<div class="col-md-3">
            {% include "demo/layouts/_sidebar" %}
		</div>

    </div>

{% endblock %}
