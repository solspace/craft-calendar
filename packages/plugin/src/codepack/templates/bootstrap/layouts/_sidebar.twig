<aside class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
        <div id="mini-cal-wrapper" class="mb-4" aria-live="polite">
            {# Use include because we're using AJAX #}
            {% include "demo/bootstrap/layouts/_mini_cal" %}
        </div>

        {% set viewType = segment2|replace({'-grid': ''}) %}
        {% set isCalendarView = viewType in ["month", "week", "day"] %}
        {% set selectedHandle = isCalendarView ? (calendarHandle|default(null) ?: (segment3 == "calendar" ? segment4 : null)) : (segment2 == "calendars" ? segment3 : null) %}
        {% set calendars = craft.calendar.calendars({
            order: "name",
            sort: "asc"
        }) %}
        {% set selectedCalendar = selectedHandle ? calendars|filter(calendar => calendar.handle == selectedHandle)|first : null %}
        {% set datePath = isCalendarView ? targetDate|date(viewType == "month" ? 'Y/m' : 'Y/m/d') : null %}
        {% set allSelected = not selectedHandle and (isCalendarView or segment2 == "calendars") %}
        {% set viewQuery = viewType in ["week", "day"] and craft.app.request.getQueryParam('view') == 'agenda' ? '?view=agenda' : '' %}

        <h2 class="h6 text-body-secondary border-top pt-3 mb-2">{{ isCalendarView ? 'Filter by calendar' : 'Calendars' }}</h2>
        <div class="dropdown">
            <button id="sidebar-calendar-menu" type="button"
                class="btn btn-outline-secondary d-flex align-items-center justify-content-between gap-2 w-100"
                data-bs-toggle="dropdown" aria-expanded="false"{% if selectedCalendar %} style="--calendar-color: {{ selectedCalendar.color }};"{% endif %}>
                <span class="d-flex align-items-center gap-2 text-truncate">
                    <span class="fas fa-calendar-alt{{ selectedCalendar ? ' calendar-color-icon' : '' }}" aria-hidden="true"></span>
                    <span class="text-truncate">{{ selectedCalendar ? selectedCalendar.name : 'All calendars' }}</span>
                </span>
                <span class="fas fa-chevron-down small flex-shrink-0" aria-hidden="true"></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end w-100 sidebar-dropdown-menu" aria-labelledby="sidebar-calendar-menu">
                <li>
                    <a href="{{ siteUrl }}demo/{{ isCalendarView ? viewType ~ '/' ~ datePath : 'calendars' }}{{ viewQuery }}"
                        class="dropdown-item{{ allSelected ? ' active' : '' }}"{% if allSelected %} aria-current="page"{% endif %}>
                        All calendars
                    </a>
                </li>
                {% if calendars|length %}
                    <li><hr class="dropdown-divider"></li>
                {% endif %}
                {% for calendar in calendars %}
                    <li>
                        <a href="{{ siteUrl }}demo/{{ isCalendarView ? viewType ~ '/calendar' : 'calendars' }}/{{ calendar.handle }}{{ isCalendarView ? '/' ~ datePath : '' }}{{ viewQuery }}"
                            class="dropdown-item{{ selectedHandle == calendar.handle ? ' active' : '' }}"
                            style="--calendar-color: {{ calendar.color }};"{% if selectedHandle == calendar.handle %} aria-current="page"{% endif %}>
                            <span class="fas fa-calendar-alt calendar-color-icon me-2" aria-hidden="true"></span>{{ calendar.name }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</aside>
