{% extends "demo/bootstrap/layouts/_layout" %}

{% set pageTitle = "Event" %}
{% set page = "event" %}

{% block content %}
    {% set eventSaved = craft.app.session.getFlash('calendar_event_saved') %}
    {% if eventSaved %}
        <div class="alert alert-success alert-dismissible mb-4" role="status">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            Event saved successfully!
        </div>
    {% endif %}

    <div class="row g-4">
        <div class="col-lg-9">
            <article id="events_calendar" class="card border-0 rounded-4 shadow-sm p-3 p-lg-4">
                {% set occurrenceDate = null %}
                {% if segment4 and segment5 and segment6 %}
                    {% set occurrenceDate = segment4 ~ "-" ~ segment5 ~ "-" ~ segment6 %}
                {% endif %}

                {% if event is not defined %}
                    {% set event = craft.calendar.events({
                        id: segment3,
                        status: null,
                    }).one() %}
                {% endif %}

                {% if event %}
                    {% set occurrence = null %}
                    {% if occurrenceDate %}
                        {% set occurrence = craft.calendar.occurrences({
                            event: event.id,
                            rangeStart: occurrenceDate,
                            rangeEnd: occurrenceDate ~ " 23:59:59",
                            status: null,
                        }).one() %}
                    {% endif %}

                    {% set displayStartDate = occurrence ? occurrence.startDate : event.startDate %}
                    {% set displayEndDate = occurrence ? occurrence.endDate : event.endDate %}
                    {% set displayAllDay = occurrence ? occurrence.allDay : event.allDay %}
                    {% set displayMultiDay = displayStartDate.format('Y-m-d') != displayEndDate.format('Y-m-d') %}

                    <header class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                        <div class="event-detail-heading">
                            <h1 class="h3 mb-2">{{ event.title }}</h1>
                            <a href="{{ siteUrl }}demo/calendars/{{ event.calendar.handle }}"
                                class="event-detail-calendar rounded-pill"
                                style="--calendar-color: {{ event.calendar.color }};">
                                <span class="event-detail-calendar-dot" aria-hidden="true"></span>
                                {{ event.calendar.name }}
                            </a>
                        </div>
                        {% if craft.calendar.exportEnabled or craft.calendar.canEditEvent(event) %}
                            <div class="d-flex flex-wrap gap-2" role="group" aria-label="Event actions">
                                {% if craft.calendar.exportEnabled %}
                                    <a href="{{ siteUrl }}demo/export/event/{{ segment3 }}" class="btn btn-outline-secondary btn-sm">
                                        <span class="fas fa-file-export me-1" aria-hidden="true"></span>Export
                                    </a>
                                {% endif %}
                                {% if craft.calendar.canEditEvent(event) %}
                                    <a href="{{ siteUrl }}demo/edit/event/{{ segment3 }}" class="btn btn-outline-secondary btn-sm">
                                        <span class="fas fa-edit me-1" aria-hidden="true"></span>Edit
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </header>

                    <div class="event-detail-summary rounded-3 p-3 p-md-4 mb-4" style="--calendar-color: {{ event.calendar.color }};">
                        <p class="text-body-secondary small fw-semibold text-uppercase mb-1">When</p>
                        <p class="fs-5 fw-semibold mb-1">{{ displayStartDate.format('l, F j, Y') }}</p>
                        {% if displayAllDay %}
                            <p class="text-body-secondary mb-0">All day</p>
                        {% else %}
                            <p class="text-body-secondary mb-0">
                                {{ displayStartDate.format('g:ia') }} –
                                {% if displayMultiDay %}
                                    {{ displayEndDate.format('l, F j, Y') }} at {{ displayEndDate.format('g:ia') }}
                                {% else %}
                                    {{ displayEndDate.format('g:ia') }}
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>

                    <dl class="event-detail-fields mb-0">
                        {% if event['location'] is defined and event.location is not empty %}
                            <div class="event-detail-field">
                                <dt>Location</dt>
                                <dd>{{ event.location }}</dd>
                            </div>
                        {% endif %}
                        <div class="event-detail-field">
                            <dt>Duration</dt>
                            <dd><span class="far fa-clock text-body-secondary me-1" aria-hidden="true"></span>{{ event.duration.humanReadable }}</dd>
                        </div>
                        {% if event['description'] is defined and event.description is not empty %}
                            <div class="event-detail-field">
                                <dt>Details</dt>
                                <dd>{{ event.description }}</dd>
                            </div>
                        {% endif %}
                        <div class="event-detail-field">
                            <dt>Repeats</dt>
                            <dd>
                                {% if event.repeats() %}
                                    <span class="fas fa-redo text-body-secondary me-1" aria-hidden="true"></span>{{ event.readableRepeatRule }}
                                {% else %}
                                    No
                                {% endif %}
                            </dd>
                        </div>
                    </dl>

                    {% if event.repeats() %}
                        <section class="border-top mt-4 pt-4" aria-labelledby="event-upcoming-title">
                            <h2 id="event-upcoming-title" class="h5 mb-3">Upcoming recurrences</h2>
                            {% set occurrences = craft.calendar.occurrences({
                                event: event.id,
                                rangeStart: 'today',
                                rangeEnd: '+6 months',
                                limit: 10,
                                status: null,
                            }).all() %}

                            {% if occurrences %}
                                <ul class="list-group list-group-flush rounded-3 border overflow-hidden">
                                    {% for occurrence in occurrences %}
                                        {% set occurrenceMultiDay = occurrence.startDate.format('Y-m-d') != occurrence.endDate.format('Y-m-d') %}
                                        <li class="list-group-item bg-body-tertiary d-flex flex-wrap align-items-center justify-content-between gap-2 px-3 py-3">
                                            <div class="event-detail-occurrence-date d-flex align-items-start gap-3">
                                                <span class="far fa-calendar text-body-secondary mt-1" aria-hidden="true"></span>
                                                <div>
                                                    <a href="{{ siteUrl }}demo/event/{{ occurrence.event.id }}/{{ occurrence.startDate.format('Y/m/d') }}" class="fw-semibold text-body text-decoration-none">
                                                        <time datetime="{{ occurrence.startDate.format('c') }}">{{ occurrence.startDate.format('l, F j, Y') }}</time>
                                                    </a>
                                                    <div class="small text-body-secondary mt-1">
                                                        {% if occurrence.allDay %}
                                                            All day{% if occurrenceMultiDay %} · through {{ occurrence.endDate.format('l, F j, Y') }}{% endif %}
                                                        {% else %}
                                                            {{ occurrence.startDate.format('g:ia') }} –
                                                            {% if occurrenceMultiDay %}
                                                                {{ occurrence.endDate.format('l, F j, Y') }} at {{ occurrence.endDate.format('g:ia') }}
                                                            {% else %}
                                                                {{ occurrence.endDate.format('g:ia') }}
                                                            {% endif %}
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                            <a href="{{ siteUrl }}demo/day/{{ occurrence.startDate.format('Y/m/d') }}" class="btn btn-outline-secondary btn-sm">View day <span class="fas fa-arrow-right ms-1" aria-hidden="true"></span></a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-body-secondary mb-0">No occurrences found for the next six months.</p>
                            {% endif %}
                        </section>
                    {% endif %}
                {% else %}
                    <h1 class="visually-hidden">Event</h1>
                    <div class="alert alert-danger mb-0" role="alert">Sorry, no event was found.</div>
                {% endif %}
            </article>
        </div>

        <div class="col-lg-3">
            {% include "demo/bootstrap/layouts/_sidebar" %}
        </div>
    </div>
{% endblock %}
