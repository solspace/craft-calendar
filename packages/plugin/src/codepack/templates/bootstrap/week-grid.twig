{% extends "demo/bootstrap/layouts/_layout" %}

{% set pageTitle = "Hourly Week Preview" %}
{% set page = "week-grid" %}

{% block headerCss %}
    <link rel="stylesheet" href="{{ siteUrl }}assets/demo/css/week-grid.css?v=1">
{% endblock %}

{% block content %}
    {% set targetDate = craft.app.request.getQueryParam('date') ?: 'today' %}
    {% set calendarHandle = craft.app.request.getQueryParam('calendar') ?: null %}

    {% set week = calendar.week({date: targetDate, calendar: calendarHandle}) %}
    {% set dateBoundsHelper = now.diff(week.nextDate)|date('%r%a') %}
    {% set weekPath = calendarHandle ? 'calendar/' ~ calendarHandle ~ '/' : '' %}

    <section class="card border-0 rounded-4 shadow-sm p-3 p-lg-4" aria-labelledby="week-grid-title">
        <div class="row align-items-center g-2 mb-3">
            <div class="col-6 col-md-3 order-1 order-md-0">
                {% if dateBoundsHelper > -365 %}
                    <a class="btn btn-outline-secondary btn-sm" href="{{ siteUrl }}demo/week-grid?framework=bootstrap&amp;date={{ week.previousDate.format('Y-m-d') }}{% if calendarHandle %}&amp;calendar={{ calendarHandle|url_encode }}{% endif %}">
                        <span class="fas fa-arrow-left" aria-hidden="true"></span> Last Week
                    </a>
                {% endif %}
            </div>
            <div class="col-12 col-md-6 order-0 text-center">
                <h1 id="week-grid-title" class="h4 mb-0">Week of {{ week.date.format('F j, Y') }}</h1>
                <span class="small text-body-secondary">Hourly view · {{ week.occurrenceCount }} event{{ week.occurrenceCount == 1 ? '' : 's' }}</span>
            </div>
            <div class="col-6 col-md-3 order-2 text-end">
                {% if dateBoundsHelper < 365 %}
                    <a class="btn btn-outline-secondary btn-sm" href="{{ siteUrl }}demo/week-grid?framework=bootstrap&amp;date={{ week.nextDate.format('Y-m-d') }}{% if calendarHandle %}&amp;calendar={{ calendarHandle|url_encode }}{% endif %}">
                        Next Week <span class="fas fa-arrow-right" aria-hidden="true"></span>
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 small">
            <a href="{{ siteUrl }}demo/week/{{ weekPath }}{{ week.date.format('Y/m/d') }}" class="link-secondary">View agenda week</a>
            <span class="text-body-secondary">Scroll across on smaller screens to see all seven days.</span>
        </div>

        <div class="week-grid-scroll border rounded-3" data-week-grid-scroll role="region" aria-label="Hourly calendar, scroll for more hours and days" tabindex="0">
            <div class="week-grid">
                <div class="week-grid-corner bg-body-tertiary border-end border-bottom" aria-hidden="true"></div>
                {% for day in week %}
                    <div class="week-grid-heading text-center border-end border-bottom px-1 py-2{{ day.dateLocalized.isToday ? ' bg-primary-subtle' : ' bg-body-tertiary' }}">
                        <a href="{{ siteUrl }}demo/day/{{ weekPath }}{{ day.date.format('Y/m/d') }}"
                            class="fw-semibold link-body-emphasis text-decoration-none"
                            aria-label="{{ day.dateLocalized.isToday ? 'Today, ' }}{{ day.date.format('l, F j, Y') }}">
                            <span class="d-block small text-body-secondary">{{ day.date.format('D') }}</span>
                            <span class="fs-5">{{ day.date.format('j') }}</span>
                            {% if day.dateLocalized.isToday %}<span class="visually-hidden"> Today</span>{% endif %}
                        </a>
                    </div>
                {% endfor %}

                <div class="week-grid-all-day-label small text-body-secondary border-end border-bottom p-2">All day</div>
                {% for day in week %}
                    <div class="week-grid-all-day border-end border-bottom p-1{{ day.dateLocalized.isToday ? ' bg-primary-subtle' : ' bg-body' }}">
                        {% for occurrence in day.allDayOccurrences %}
                            {% set event = occurrence.event %}
                            <a class="week-grid-all-day-event d-block rounded-2 px-2 py-1 mb-1 small fw-semibold text-decoration-none text-truncate"
                                href="{{ siteUrl }}demo/event/{{ event.id }}{% if event.repeats() or event.rrule is not empty %}/{{ occurrence.startDate.format('Y/m/d') }}{% endif %}"
                                style="--event-color: {{ event.calendar.color }};"
                                title="{{ event.title }}">{{ event.title }}</a>
                        {% endfor %}
                    </div>
                {% endfor %}

                <div class="week-grid-hours border-end" aria-hidden="true">
                    {% for hour in 0..23 %}
                        <span class="week-grid-hour text-body-secondary small" style="--hour: {{ hour }};">{{ hour == 0 ? '12 AM' : (hour < 12 ? hour ~ ' AM' : (hour == 12 ? '12 PM' : (hour - 12) ~ ' PM')) }}</span>
                    {% endfor %}
                </div>
                {% for day in week %}
                    <div class="week-grid-day border-end{{ day.dateLocalized.isToday ? ' week-grid-today' }}"
                        role="group" aria-label="{{ day.date.format('l, F j, Y') }}" data-week-grid-day>
                        {% for occurrence in day.timedOccurrences %}
                            {% set event = occurrence.event %}
                            {% set startsToday = occurrence.startDate.format('Y-m-d') == day.date.format('Y-m-d') %}
                            {% set endsToday = occurrence.endDate.format('Y-m-d') == day.date.format('Y-m-d') %}
                            {% set startMinute = startsToday ? occurrence.startDate.format('G') * 60 + occurrence.startDate.format('i') : 0 %}
                            {% set endMinute = endsToday ? occurrence.endDate.format('G') * 60 + occurrence.endDate.format('i') : 1440 %}
                            {% if endMinute > startMinute %}
                                <a class="week-grid-event rounded-2 text-decoration-none"
                                    href="{{ siteUrl }}demo/event/{{ event.id }}{% if event.repeats() or event.rrule is not empty %}/{{ occurrence.startDate.format('Y/m/d') }}{% endif %}"
                                    style="--event-color: {{ event.calendar.color }}; top: {{ startMinute * 0.8 }}px; height: {{ (endMinute - startMinute) * 0.8 - 2 }}px;"
                                    data-start="{{ startMinute }}" data-end="{{ endMinute }}"
                                    aria-label="{{ event.title }}. {{ occurrence.startDate.format('l, F j, g:ia') }} to {{ occurrence.endDate.format('l, F j, g:ia') }}">
                                    <span class="week-grid-event-title d-block fw-semibold text-truncate">{{ event.title }}</span>
                                    <span class="week-grid-event-time d-block text-truncate">{{ startsToday ? occurrence.startDate.format('g:ia') : 'Continues' }}{% if endsToday %} – {{ occurrence.endDate.format('g:ia') }}{% endif %}</span>
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}

{% block footerJs %}
    <script>window.calendarDemoFramework = 'bootstrap';</script>
    <script src="{{ siteUrl }}assets/demo/js/week-grid.js?v=1"></script>
{% endblock %}
