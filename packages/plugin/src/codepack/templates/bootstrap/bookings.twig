{% extends 'demo/bootstrap/layouts/_layout' %}
{% set pageTitle = 'Book a time'|t('calendar') %}
{% set page = 'bookings' %}

{% block content %}
    {% set bookingCalendars = craft.calendar.schedulingCalendars() %}
    {% set requestedCalendar = craft.app.request.getQueryParam('calendarId') %}
    {% set selectedCalendar = bookingCalendars|filter(item => item.id == requestedCalendar)|first ?: bookingCalendars|first %}
    <header class="mb-4 pt-2">
        <h1 class="h3 mb-2">{{ 'Book a time'|t('calendar') }}</h1>
        <p class="text-body-secondary mb-0">{{ 'Choose a resource and an available time.'|t('calendar') }}</p>
    </header>
    {% if selectedCalendar %}
        <div class="row g-4 align-items-start">
            <aside class="col-lg-4 col-xl-3">
                <h2 class="h6 text-body-secondary mb-3">{{ 'Choose a resource'|t('calendar') }}</h2>
                <nav class="d-grid gap-2" aria-label="{{ 'Scheduling calendars'|t('calendar') }}">
                    {% for resource in bookingCalendars %}
                        {% set selected = resource.id == selectedCalendar.id %}
                        <a class="d-block p-3 rounded-3 border text-decoration-none {{ selected ? 'border-primary bg-primary-subtle text-primary-emphasis' : 'bg-body text-body' }}" href="{{ url('demo/bookings', {calendarId: resource.id, framework: 'bootstrap'}) }}"{% if selected %} aria-current="page"{% endif %}>
                            <span class="d-flex align-items-center gap-2 fw-semibold"><span class="rounded-circle flex-shrink-0" style="width:10px;height:10px;background-color:{{ resource.color }}" aria-hidden="true"></span>{{ resource.name }}</span>
                            <span class="d-block small mt-2 text-body-secondary">{{ '{duration} minutes'|t('calendar', {duration: resource.schedulingSettings.duration}) }} · {{ resource.schedulingSettings.timezone }}</span>
                        </a>
                    {% endfor %}
                </nav>
            </aside>
            <div class="col-lg-8 col-xl-9">
                {{ craft.calendar.bookingForm(selectedCalendar.id, {framework: 'bootstrap', booking: booking ?? null}) }}
            </div>
        </div>
    {% else %}
        <div class="card border-0 rounded-4 shadow-sm p-4 p-lg-5 text-center">
            <span class="fas fa-calendar-alt text-body-secondary fs-2 mb-3" aria-hidden="true"></span>
            <h2 class="h5">{{ 'No booking times are available yet.'|t('calendar') }}</h2>
            <p class="text-body-secondary mb-0">{{ 'Please check back later.'|t('calendar') }}</p>
        </div>
    {% endif %}
{% endblock %}
