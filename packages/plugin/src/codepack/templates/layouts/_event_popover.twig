{% set displayStartDate = occurrence is defined ? occurrence.startDate : event.startDate %}
{% set displayEndDate = occurrence is defined ? occurrence.endDate : event.endDate %}
{% set displayAllDay = occurrence is defined ? occurrence.allDay : event.allDay %}
{% set displayMultiDay = displayStartDate.format('Y-m-d') != displayEndDate.format('Y-m-d') %}

<div class="qtip d-none">
    <div class="title">
        {{ event.title }}
        <span class='event_time'>
            <span class='far fa-clock'></span>
            {% if displayAllDay %}
                All Day
                {% if displayMultiDay %}
                    ({{ event.duration.days }} days)
                {% endif %}
            {% else %}
                {% if displayMultiDay %}
                    {% if day.containsDate(displayStartDate) %}
                        Starts {{ displayStartDate.format('g:ia') }}
                    {% elseif day.containsDate(displayEndDate) %}
                        Ends {{ displayEndDate.format('g:ia') }}
                    {% else %}
                        All Day
                    {% endif %}
                    ({{ event.duration.days }} days)
                {% else %}
                    {{ displayStartDate.format('g:ia') }} - {{ displayEndDate.format('g:ia') }}
                    ({{ event.duration.humanReadable }})
                {% endif %}
            {% endif %}
            </span>
    </div>
    <div class="content">
        <span class='fas fa-calendar-alt' style='color: {{ event.calendar.color }};'></span>
        <span style='color: {{ event.calendar.color }};'>{{ event.calendar.name }}</span>
        <hr />
        {% if displayAllDay %}
            {% if displayMultiDay %}
                <b>Starts</b> {{ displayStartDate.format('F j, Y') }}<br />
                <b>Ends</b> {{ displayEndDate.format('F j, Y') }}
            {% else %}
                {{ displayStartDate.format('F j, Y') }} (All Day)
            {% endif %}
        {% else %}
            <b>Starts</b> {{ displayStartDate.format('F j, Y \\a\\t g:ia') }}<br />
            <b>Ends</b> {{ displayEndDate.format('F j, Y \\a\\t g:ia') }}
        {% endif %}

        {% if event.repeating %}
            <hr />
            <span class='fas fa-redo'></span>&nbsp;<b>Repeats</b>
            {{ event.readableRepeatRule }}
        {% endif %}
    </div>
</div>
