{% set displayStartDate = occurrence is defined ? occurrence.startDate : event.startDate %}
{% set displayEndDate = occurrence is defined ? occurrence.endDate : event.endDate %}
{% set displayAllDay = occurrence is defined ? occurrence.allDay : event.allDay %}
{% set displayMultiDay = displayStartDate.format('Y-m-d') != displayEndDate.format('Y-m-d') %}

<div class="qtip d-none">
    <div class="title">{{ event.title }}</div>
    <div class="content">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="badge text-bg-light border">
                <span class="fas fa-calendar-alt" aria-hidden="true"></span> {{ event.calendar.name }}
            </span>
            {% if displayAllDay %}
                <span class="badge text-bg-secondary">All day</span>
            {% endif %}
        </div>
        <div class="border-top pt-2">
            <div class="d-flex justify-content-between gap-3 mb-1">
                <span class="text-body-secondary">Starts</span>
                <span class="text-end fw-medium">
                    {{ displayStartDate.format(displayAllDay ? 'M j, Y' : 'M j, Y g:ia') }}
                </span>
            </div>
            {% if not displayAllDay or displayMultiDay %}
                <div class="d-flex justify-content-between gap-3">
                    <span class="text-body-secondary">Ends</span>
                    <span class="text-end fw-medium">
                        {{ displayEndDate.format(displayAllDay ? 'M j, Y' : 'M j, Y g:ia') }}
                    </span>
                </div>
            {% endif %}
        </div>
        {% if event.repeating %}
            <div class="border-top mt-2 pt-2">
                <span class="text-body-secondary">Repeats</span>
                <div>{{ event.readableRepeatRule }}</div>
            </div>
        {% endif %}
    </div>
</div>
