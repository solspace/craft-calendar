{% for occurrence in occurrences.all %}
    {% set event = occurrence.event %}

    <a href="{{ siteUrl }}demo/event/{{ event.id }}{% if event.repeats() or event.rrule is not empty %}/{{ occurrence.startDate.format('Y/m/d') }}{% endif %}"
        class="list-group-item list-group-item-action calendar-accent-border d-flex justify-content-between align-items-center gap-2 py-3 rounded-0"
        style="--calendar-color: {{ event.calendar.color }};">
        <strong>{{ event.title }}</strong>
        <small class="text-body-secondary text-nowrap">{{ occurrence.startDate.format('F j, Y') }}</small>
    </a>
{% else %}
    <span class="list-group-item">
        No events could be found within the specified time range (today until 6 months from today) for this Calendar.
    </span>
{% endfor %}
