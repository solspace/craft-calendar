<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Demo Templates for Calendar">
    <meta name="author" content="Solspace">
    <title>Calendar Demo | {{ pageTitle ? pageTitle : "Home" }}</title>
    <meta name="theme-color" content="#ffffff">
    <script src="{{ siteUrl }}assets/demo/js/theme.js"></script>
    <script src="{{ siteUrl }}assets/demo/js/framework.js" data-assets-base="{{ siteUrl }}assets/demo/"></script>
    <link href="https://use.fontawesome.com/releases/v5.2.0/css/all.css" rel="stylesheet">
    <noscript><link rel="stylesheet" href="{{ siteUrl }}assets/demo/css/tailwind.css"></noscript>
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/demo/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/demo/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/demo/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/demo/favicon/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    {% block headerCss %}{% endblock %}
</head>

{# Acquire URL segments #}
{% set segment1 = craft.app.request.segment(1) %}
{% set segment2 = craft.app.request.segment(2) %}
{% set segment3 = craft.app.request.segment(3) %}
{% set segment4 = craft.app.request.segment(4) %}
{% set segment5 = craft.app.request.segment(5) %}
{% set segment6 = craft.app.request.segment(6) %}
{% set segment7 = craft.app.request.segment(7) %}

<body id="top" class="bg-body-tertiary">
<a class="visually-hidden-focusable position-absolute bg-body text-body p-2" href="#main-content">Skip to main content</a>

{% if page is not defined %}
    {% set page = "month" %}
{% endif %}

<nav class="navbar navbar-expand-xl bg-dark fixed-top shadow-sm" data-bs-theme="dark" aria-label="Main navigation">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand d-inline-flex align-items-center gap-2" href="{{ siteUrl }}demo/">
            <img src="{{ siteUrl }}assets/demo/images/icon.svg" alt="" width="30" height="30">
            <span>Calendar Demo</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto gap-xl-1">
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'month' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/month"{% if page == 'month' %} aria-current="page"{% endif %}>Month</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'week' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/week"{% if page == 'week' %} aria-current="page"{% endif %}>Week</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'day' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/day"{% if page == 'day' %} aria-current="page"{% endif %}>Day</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'events' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/events"{% if page == 'events' %} aria-current="page"{% endif %}>Events List</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'calendars' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/calendars"{% if page == 'calendars' %} aria-current="page"{% endif %}>Calendars</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'fullcalendar' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/fullcalendar"{% if page == 'fullcalendar' %} aria-current="page"{% endif %}>Full Calendar</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-2 rounded-2{{ page == 'edit' ? ' active bg-white bg-opacity-10' }}" href="{{ siteUrl }}demo/edit/event/new"{% if page == 'edit' %} aria-current="page"{% endif %}>Create</a>
                </li>
            </ul>
            <div class="navbar-nav dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                    Resources
                </a>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                    <a class="dropdown-item" href="https://plugins.craftcms.com/calendar">Plugin Store</a>
                    <a class="dropdown-item" href="https://docs.solspace.com/craft/calendar/v6/">Documentation</a>
                    <a class="dropdown-item" href="https://docs.solspace.com/support/">Support</a>
                </div>
            </div>
            <div class="ms-xl-2 mt-2 mt-xl-0">
                <label class="visually-hidden" for="framework-select">CSS framework</label>
                <select id="framework-select" class="form-select form-select-sm framework-select" data-framework-select aria-label="CSS framework">
                    <option value="tailwind">Tailwind 4</option>
                    <option value="bootstrap">Bootstrap 5</option>
                </select>
            </div>
            <div class="dropdown ms-xl-2 mt-2 mt-xl-0">
                <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="themeMenu"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="Theme: Auto" data-theme-toggle>
                    <span class="fas fa-adjust me-1" aria-hidden="true"></span>
                    <span data-theme-label>Auto</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="themeMenu">
                    <li><button class="dropdown-item d-flex align-items-center justify-content-between gap-3" type="button" data-theme-value="light" aria-pressed="false">Light <span class="fas fa-check d-none" aria-hidden="true"></span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center justify-content-between gap-3" type="button" data-theme-value="dark" aria-pressed="false">Dark <span class="fas fa-check d-none" aria-hidden="true"></span></button></li>
                    <li><button class="dropdown-item d-flex align-items-center justify-content-between gap-3" type="button" data-theme-value="auto" aria-pressed="true">Auto <span class="fas fa-check" aria-hidden="true"></span></button></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<main id="main-content" class="container py-3 pb-5" tabindex="-1">
    {% block content %}{% endblock %}
</main>

<footer class="bg-body-tertiary text-body-secondary py-4 mt-5">
    <div class="container">
        <p class="float-end mb-0">
            <a href="#top">Back to top</a>
        </p>
        <p class="mb-0"><a href="https://docs.solspace.com/craft/calendar/v6/">Calendar</a> for Craft CMS. &copy; 2010-{{ "now"|date("Y") }} <a href="https://solspace.com">Solspace, Inc.</a></p>
    </div>
</footer>

<script src="{{ siteUrl }}assets/demo/js/main.js"></script>

{% block footerJs %}{% endblock %}
</body>
</html>
