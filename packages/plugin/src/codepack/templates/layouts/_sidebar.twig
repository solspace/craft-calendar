<aside class="card border-0 rounded-4 shadow-sm">
    <div class="card-body">
        <div id="mini-cal-wrapper" class="mb-4" aria-live="polite">
            {# Use include because we're using AJAX #}
            {% include "demo/layouts/_mini_cal" %}
        </div>

        <h2 class="h5 border-top pt-3 mb-3">
            {% if segment2 in ["month", "week", "day"] %}
                Filter by Calendar
            {% else %}
                Calendars
            {% endif %}
        </h2>
        <div class="list-group small">
            {% set calendars = craft.calendar.calendars({
                limit: 10,
                order: "name",
                sort: "asc"
            }) %}

            {% for calendar in calendars %}
                {% if segment2 in ["month", "week", "day"] %}
                    {% set urlPart = segment2~"/calendar" %}
                {% else %}
                    {% set urlPart = "calendars" %}
                {% endif %}

                <a href="{{ siteUrl }}demo/{{ urlPart }}/{{ calendar.handle }}"
                    class="list-group-item list-group-item-action calendar-filter-link"
                    style="--calendar-color: {{ calendar.color }}; --calendar-surface: {{ calendar.lighterColor }}; --calendar-contrast: {{ calendar.contrastColor }};"{% if segment3 == calendar.handle or segment4 == calendar.handle %} aria-current="page"{% endif %}>
                    <span class="fas fa-calendar-alt calendar-color-icon" aria-hidden="true"></span>&nbsp;
                    {{ calendar.name }}
                </a>
            {% endfor %}
        </div>
    </div>
</aside>
