{% extends "demo/layouts/_layout" %}

{% set pageTitle = "Calendars" %}
{% set page = "calendars" %}

{% block content %}

	<div class="row g-4">

		<div class="col-lg-9">

			<h1 class="h4 mb-3">Events by Calendar</h1>
			{% set calendars = craft.calendar.calendars({
				handle: segment3 ? segment3 : null,
				orderBy: "name",
				sort: "asc"
			}) %}

			{% for calendar in calendars %}

				<div class="card mb-4 border-0 rounded-4 shadow-sm overflow-hidden">
					<h2 class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center fs-5 mb-0 py-3"
					    style="color: {{ calendar.contrastColor }}; background-color: {{ calendar.lighterColor }};">
						<span>
							<span class="fas fa-calendar-alt" aria-hidden="true"></span>&nbsp;
							{{ calendar.name }}
						</span>
						{% if craft.calendar.exportEnabled %}
							<a href="{{ siteUrl }}demo/export/calendar/{{ calendar.id }}" class="btn btn-light btn-sm border">
								<span class="fas fa-file-export"></span>&nbsp;
								Export Events
							</a>
						{% endif %}
					</h2>
					<ul class="list-group list-group-flush">
					{% if craft.calendar.exportEnabled and calendar.icsUrl %}
						<li class="list-group-item">
							<div class="input-group">
								<label class="input-group-text" for="ics-url-{{ calendar.id }}">ICS Subscribe</label>
								<input id="ics-url-{{ calendar.id }}" type="text" class="form-control" value="{{ calendar.icsUrl }}" readonly onclick="this.select();">
							</div>
						</li>
					{% endif %}
						<li class="list-group-item">
							<strong>Description:</strong>
							{{ calendar.description }}
						</li>
						<li class="list-group-item">
							<strong>View events by:&nbsp;</strong>
							<a href="{{ siteUrl }}demo/month/calendar/{{ calendar.handle }}" class="btn btn-secondary btn-sm me-1 mb-1">Month</a>
							<a href="{{ siteUrl }}demo/week/calendar/{{ calendar.handle }}" class="btn btn-secondary btn-sm me-1 mb-1">Week</a>
							<a href="{{ siteUrl }}demo/day/calendar/{{ calendar.handle }}" class="btn btn-secondary btn-sm me-1 mb-1">Day</a>
						</li>
						<li class="list-group-item">
							<strong>Upcoming Events:</strong>
							<div class="list-group mt-2">
								{% set occurrences = craft.calendar.occurrences({
									rangeStart: "today",
									rangeEnd: "6 months",
									calendarId: calendar.id,
									limit: segment3 ? 20 : 5
								}) %}
								{% include "demo/layouts/_calendar_events" %}
							</div>
						</li>
					</ul>
				</div>


			{% else %}
				<div class="alert alert-danger" role="alert">
					<p class="lead">
						Sorry, no calendars were found.
					</p>
				</div>
			{% endfor %}

		</div>

		<div class="col-lg-3">
			{% include "demo/layouts/_sidebar" %}
		</div>

	</div>

{% endblock %}
