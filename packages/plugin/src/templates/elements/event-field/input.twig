{% do craft.app.view.registerAssetBundle("Solspace\\Calendar\\Resources\\Bundles\\EventEditBundle") %}
{% set event = element %}

{% set repeatRulesEnabled = event.calendar.allowRepeatingEvents ?? true %}

<div data-event-builder-scope>
	<div data-event-builder>
		<script type="application/json" data-event-builder-config>{{ event.builderConfig|json_encode|raw }}</script>

		<input type="hidden" name="start" value="{{ event.getStartDate().toAtomString() }}"/>
		<input type="hidden" name="end" value="{{ event.getEndDate().toAtomString() }}"/>
		<input type="hidden" name="until" value="{{ event.getUntil() ? event.getUntil().toAtomString() : "" }}" />

		<input type="hidden" name="allDay" value="{{ event.allDay ? 1 : 0 }}"/>
		<input type="hidden" name="repeatType" value="{{ event.repeatType }}" />
		<input type="hidden" name="repeatEndType" value="{{ event.repeatEndType }}" />
		<input type="hidden" name="rrule" value="{{ event.rrule }}" />

		<div data-event-builder-root></div>
	</div>
</div>

<input type="hidden" name="calendarId" value="{{ event.calendarId }}"/>
