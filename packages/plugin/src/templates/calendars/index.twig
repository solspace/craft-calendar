{% extends "calendar/layouts/_calendarsLayout" %}

{% set selectedSubnavItem = "calendars" %}
{% set title = "Calendars"|t('calendar') %}

{% set content %}
    <div id="nocalendars"{% if calendars %} class="hidden"{% endif %}>
        <p>{{ "No calendars exist yet."|t('calendar') }}</p>
    </div>

    {% if calendars|length %}
        <table id="calendars" class="data fullwidth collapsible">
            <thead>
            <tr>
            <th scope="col">{{ "Name"|t('calendar') }}</th>
            <th scope="col">{{ "Type"|t('calendar') }}</th>
            <th scope="col">{{ "Handle"|t('calendar') }}</th>
            <th scope="col">{{ "Description"|t('calendar') }}</th>
            {% if craft.calendar.pro %}
                <th scope="col">{{ "ICS sharing"|t('calendar') }}</th>
            {% endif %}
            <th scope="col" class="calendar-actions-column"><span class="visually-hidden">{{ 'Actions'|t('app') }}</span></th>
            </tr>
            </thead>
            <tbody>
            {% for calendar in calendars %}
                <tr data-id="{{ calendar.id }}" data-name="{{ calendar.name|t }}">
                    <th scope="row" data-title="{{ 'Name'|t('calendar') }}">
                        <span class="calendar-name">
                        <span class="color-indicator" style="background-color: {{ calendar.color }};"></span>
                        {% if currentUser.can("calendar-editCalendars") %}
                            <a href="{{ url('calendar/calendars/' ~ calendar.handle) }}">
                                {{ calendar.name }}
                            </a>
                        {% else %}
                            {{ calendar.name }}
                        {% endif %}
                        </span>
                    </th>
                    <td data-title="{{ 'Type'|t('calendar') }}"><span class="calendar-type {{ calendar.isScheduling ? 'scheduling' : 'events' }}">{{ calendar.typeOptions()[calendar.type] }}</span></td>
                    <td data-title="{{ 'Handle'|t('calendar') }}">
                        <code>
                            {{ calendar.handle }}
                        </code>
                    </td>
                    <td class="calendar-description" data-title="{{ 'Description'|t('calendar') }}">
                        {% if calendar.description %}<span title="{{ calendar.description }}">{{ calendar.description }}</span>{% else %}<span class="light">—</span>{% endif %}
                    </td>
                    {% if craft.calendar.pro %}
                        <td class="calendar-sharing" data-title="{{ 'ICS sharing'|t('calendar') }}">
                            <div class="calendar-sharing-actions">
                            {% if calendar.isScheduling %}
                                <span class="light">—</span>
                            {% elseif calendar.icsHash %}
                                <a href="javascript:;"
                                   data-link="{{ calendar.icsUrl }}"
                                   class="copy-ics-link btn small"
                                >
                                    {{ "Copy link"|t('calendar') }}
                                </a>
                                <a href="javascript:;"
                                   data-calendar-id="{{ calendar.id }}"
                                   class="disable-ics btn submit small"
                                >
                                    {{ "Disable ICS"|t('calendar') }}
                                </a>
                            {% else %}
                                <a href="javascript:;"
                                   data-calendar-id="{{ calendar.id }}"
                                   class="enable-ics btn small"
                                >
                                    {{ "Share this calendar"|t('calendar') }}
                                </a>
                            {% endif %}
                            </div>
                        </td>
                    {% endif %}
                    <td class="calendar-actions-column">
                        <div class="calendar-row-actions">
                        {% if currentUser.can("calendar-editCalendars") %}
                            <a class="clone icon" title="{{ 'Clone'|t('calendar') }}" aria-label="{{ 'Clone'|t('calendar') }}" role="button" tabindex="0" data-id="{{ calendar.id }}">
                                <svg aria-hidden="true" focusable="false" data-prefix="far" data-icon="copy" class="svg-inline--fa fa-copy fa-w-14" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z"></path></svg>
                            </a>
                        {% endif %}
                        {% if currentUser.can("calendar-deleteCalendars") %}
                            <a class="delete icon" title="{{ 'Delete'|t('calendar') }}" aria-label="{{ 'Delete'|t('calendar') }}" role="button" tabindex="0"></a>
                        {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endset %}

{% css %}
    #content { padding: 0; }
    #calendars th, #calendars td { vertical-align:middle; }
    #calendars tbody th, #calendars tbody td { padding-top:12px; padding-bottom:12px; }
    #calendars tbody tr + tr { border-top:1px solid var(--hairline-color, #edf0f4); }
    #calendars tbody tr:hover { background:var(--pane-bg-color, #f8fafc); }
    #calendars .calendar-name { display:inline-flex; align-items:center; gap:9px; }
    #calendars .calendar-name .color-indicator { flex:none; margin:0; }
    #calendars .calendar-type { display:inline-flex; padding:4px 9px; border-radius:5px; background:var(--gray-100, #eef1f5); color:var(--medium-text-color, #596778); font-size:12px; font-weight:500; line-height:1.4; white-space:nowrap; }
    #calendars .calendar-type.scheduling { background:#e8f0fb; color:#356091; }
    #calendars code { font-size:13px; white-space:nowrap; }
    #calendars .calendar-description { width:40%; }
    #calendars .calendar-description > span { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--medium-text-color, #596778); }
    #calendars .calendar-sharing-actions { display:flex; align-items:center; gap:6px; white-space:nowrap; }
    #calendars .calendar-actions-column { width:76px; min-width:76px; box-sizing:content-box; text-align:right; }
    #calendars .calendar-row-actions { display:inline-flex; align-items:center; justify-content:flex-end; gap:4px; white-space:nowrap; }
    #calendars .calendar-row-actions > .icon { display:inline-flex; align-items:center; justify-content:center; width:32px; height:32px; margin:0; border-radius:5px; color:var(--medium-text-color, #596778); cursor:pointer; text-decoration:none; }
    #calendars .calendar-row-actions > .icon:hover { background:var(--gray-100, #edf1f6); color:var(--text-color, #263344); }
    #calendars .calendar-row-actions > .delete:hover { background:#fbe9e9; color:var(--error-color, #cf2929); }
    #calendars .calendar-row-actions > .icon:focus-visible { outline:2px solid var(--link-color, #2563eb); outline-offset:2px; }
    #calendars .calendar-row-actions svg { width:14px; height:16px; }
    @media (max-width:767px) {
        #calendars .calendar-description { width:auto; }
        #calendars .calendar-actions-column { width:auto; }
        #calendars .calendar-row-actions { justify-content:flex-start; }
    }
{% endcss %}

{% js %}
    document.querySelectorAll('#calendars .calendar-row-actions .clone').forEach(action => {
        action.addEventListener('keydown', event => {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                action.click();
            }
        });
    });
    var adminTable = new Craft.AdminTable({
    tableSelector: '#calendars',
    noObjectsSelector: '#nocalendars',
    newObjectBtnSelector: '#newcalendarcontainer',
    deleteAction: 'calendar/calendars/delete',
    confirmDeleteMessage: {{ "Are you sure you want to delete “{name}” and all its events and bookings?"|t('calendar')|json_encode|raw }}
    });
{% endjs %}
