{% import '_includes/forms' as forms %}
{% set schedulingPrefix = schedulingPrefix ?? 'scheduling' %}
<hr>
<h2>{{ 'Booking Rules'|t('calendar') }}</h2>
{% for key, definition in {
    duration: ['Booking Duration', 'Length of a guest booking, in minutes.'],
    increment: ['Start Time Increments', 'Offer starting times this many minutes apart, beginning at each opening period.'],
    buffer: ['Gap After Bookings', 'Reserve this many extra minutes after a confirmed booking. The booking and gap must fit within opening hours.'],
    minimumNotice: ['Minimum Notice', 'How many hours in advance guests must book. Use 0 for no minimum.'],
    maximumAdvance: ['Advance Booking Window', 'How many days ahead guests can book.']
} %}
    {{ forms.textField({label: definition[0]|t('calendar'), instructions: definition[1]|t('calendar'), name: schedulingPrefix~'['~key~']', type: 'number', min: key in ['buffer', 'minimumNotice'] ? 0 : 1, value: attribute(scheduling, key), required: true, size: 8, errors: scheduling.getErrors(key)}) }}
{% endfor %}
{{ forms.lightswitchField({label: 'Allow Overlapping Bookings'|t('calendar'), instructions: 'Allow unrestricted overlapping bookings in this calendar. This does not enforce a capacity limit.'|t('calendar'), name: schedulingPrefix~'[allowOverlap]', on: scheduling.allowOverlap}) }}
<hr>
<h2>{{ 'Booking Requests'|t('calendar') }}</h2>
{% if not (bookingDefaults ?? false) %}
{{ forms.lightswitchField({label: 'Allow Guest Booking Requests'|t('calendar'), instructions: 'Allow visitors to view available times and submit the guest booking form without signing in.'|t('calendar'), name: schedulingPrefix~'[allowGuests]', on: scheduling.allowGuests}) }}
{% endif %}
{{ forms.lightswitchField({label: 'Require Approval'|t('calendar'), instructions: 'Receive requests for review. Requested times are reserved only after confirmation. Turn this off to confirm available times immediately.'|t('calendar'), name: schedulingPrefix~'[requireApproval]', on: scheduling.requireApproval}) }}
{{ forms.textField({label: 'Staff Notification Email'|t('calendar'), instructions: 'Optional email address for new booking requests and booking updates. Customers also receive a notification.'|t('calendar'), name: schedulingPrefix~'[notificationEmail]', type: 'email', value: scheduling.notificationEmail, errors: scheduling.getErrors('notificationEmail')}) }}
{% if not (bookingDefaults ?? false) %}
<p class="light">{{ 'All bookings share one custom field layout. Manage it from Bookings → Booking fields.'|t('calendar') }}</p>
{% endif %}
