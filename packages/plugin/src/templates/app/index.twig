{% extends "calendar/layouts/_layout" %}
{% import "_includes/forms" as forms %}

{% set title = "Calendar"|t('calendar') %}

{% set crumbs = [
    { label: craft.calendar.name, url: url("calendar") },
    { label: "Events"|t("calendar"), url: url("calendar/events") },
    { label: title, url: url("calendar/app"), current: true },
] %}

{% block sidebar %}
	<div id="calendar-sidebar">
		<div data-sidebar-root></div>
	</div>
{% endblock %}

{% block content %}

	<div id="calendar-app">
		<script data-config type="application/json">{{- configuration | json_encode | raw -}}</script>
		<div data-root></div>
	</div>

{% endblock %}
