{% extends "calendar/layouts/_layoutWithoutSettings" %}

{% set selectedSubnavItem = 'settings' %}
{% set fullPageForm = fullPageForm ?? true %}

{% set navItems = {
'general': { title: "General Settings"|t('calendar'), label: 'General'|t('calendar') },
'spam-protection': { title: "Spam Protection"|t('calendar') },
'events-heading': { heading: 'Events'|t('calendar') },
'overview': { title: "Event Views"|t('calendar') },
'events': { title: "Event Settings"|t('calendar') },
'guest-access': { title: "Guest Access"|t('calendar') },
'bookings-heading': { heading: 'Bookings'|t('calendar') },
'bookings': { title: "Booking Settings"|t('calendar') },
'booking-defaults': { title: "Booking Defaults"|t('calendar') },
'tools-heading': { heading: 'Tools'|t('calendar') },
'demo-templates': {title: 'Demo Templates'|t('calendar')},
'diagnostics': {title: 'Diagnostics'|t('calendar')},
} %}

{% set selectedItem = craft.app.request.getSegment(3)|default %}

{% set docTitle = navItems[selectedItem].title~' - '~title %}

{% block actionButton %}
    <div class="buttons">
        <div class="btngroup submit">
            <input type="submit" class="btn submit" value="{{ 'Save'|t('calendar') }}">
        </div>
    </div>
{% endblock %}

{% block sidebar %}
    <nav>
        <ul>
            {% for id, item in navItems %}
                {% if id == 'diagnostics' or craft.app.config.general.allowAdminChanges %}
                    {% if item.heading is defined %}
                        <li class="heading"><span>{{ item.heading }}</span></li>
                    {% else %}
                        <li><a href="{{ url('calendar/settings/'~id) }}"{% if id == selectedItem %} class="sel" aria-current="page"{% endif %}>{{ item.label ?? item.title }}</a></li>
                    {% endif %}
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
{% endblock %}
