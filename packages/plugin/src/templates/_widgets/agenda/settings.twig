{% import "_includes/forms" as forms %}


{{ forms.textField({
    label: "Title"|t('calendar'),
    instructions: "Customise the widget title. Leave blank for default."|t('calendar'),
    id: 'title',
    name: 'title',
    value: settings.title,
    errors: settings.getErrors('title')
}) }}

{% set viewOptions = {day: 'Day'|t('calendar'), week: 'Week'|t('calendar'), month: 'Month'|t('calendar'), agenda: 'Agenda'|t('calendar')} %}
{% set viewSettingsId = 'calendar-widget-views-' ~ random() %}
<div id="{{ viewSettingsId }}" data-calendar-widget-views>
{{ forms.checkboxGroupField({
    label: 'Available views'|t('calendar'),
    instructions: 'Choose the views available in this widget. Select at least one.'|t('calendar'),
    id: 'enabledViews',
    name: 'enabledViews',
    options: viewOptions,
    values: settings.enabledViews is iterable ? settings.enabledViews : [],
    errors: settings.getErrors('enabledViews')
}) }}
<div data-default-view-field{{ settings.getEnabledViews()|length < 2 ? ' hidden' }}>
{{ forms.selectField({
    label: 'Default view'|t('calendar'),
    instructions: 'Choose which available view opens when the widget loads.'|t('calendar'),
    id: 'view',
    name: 'view',
    options: viewOptions,
    value: settings.getDefaultView(),
    errors: settings.getErrors('view')
}) }}
</div>
</div>
{% js %}
(() => {
    const root = document.getElementById('{{ viewSettingsId|namespaceInputId }}');
    if (!root) return;
    const select = root.querySelector('select');
    const field = root.querySelector('[data-default-view-field]');
    const updateViews = () => {
        const enabled = Array.from(root.querySelectorAll('input[type="checkbox"]:checked'), input => input.value);
        for (const option of select.options) {
            option.disabled = !enabled.includes(option.value);
            option.hidden = option.disabled;
        }
        if (enabled.length && !enabled.includes(select.value)) {
            select.value = enabled.includes('month') ? 'month' : enabled[0];
        }
        field.hidden = enabled.length < 2;
    };
    root.addEventListener('change', updateViews);
    updateViews();
})();
{% endjs %}

{{ forms.checkboxSelectField({
    label: "Calendars"|t('calendar'),
    instructions: "Which calendar entries do you wish to show?"|t('calendar'),
    id: 'calendars',
    name: 'calendars',
    showAllOption: true,
    options: calendars,
    values: settings.calendars,
    errors: settings.getErrors('calendars')
}) }}

{% if craft.app.isMultisite %}

    {{ forms.selectField({
        label: "Site"|t('calendar'),
        instructions: "Choose which site's events to load for this widget"|t('calendar'),
        id: 'site',
        name: 'siteId',
        options: siteOptions,
        value: settings.siteId,
        errors: settings.getErrors('siteId')
    }) }}

{% endif %}
