{# Times, cancellation and slug of the occurrence slideout #}
{% import '_includes/forms' as forms %}

<div class="calendar-occurrence-meta">
    <section class="calendar-occurrence-date-time" aria-labelledby="occurrence-date-time-label">
        <div class="calendar-occurrence-date-time-heading">
            <h2 id="occurrence-date-time-label">{{ 'Date & Time'|t('calendar') }}</h2>
            <div class="calendar-occurrence-field-toggle calendar-occurrence-own-times">
                {{ forms.lightswitch({
                    id: 'ownTimes',
                    labelId: 'ownTimes-label',
                    name: 'ownTimes',
                    on: ownTimes,
                    small: true,
                }) }}
                <label id="ownTimes-label" for="ownTimes">{{ 'Override'|t('calendar') }}</label>
            </div>
        </div>
        <p class="instructions">{{ 'Enable Override to change the date or time for this occurrence only.'|t('calendar') }}</p>

        {% include 'calendar/occurrences/_times' with {
            readOnly: false,
            ownTimes: ownTimes,
            startDate: startDate,
            endDate: endDate,
            allDay: allDay,
        } only %}
        {% include 'calendar/occurrences/_times' with {
            readOnly: true,
            ownTimes: ownTimes,
            startDate: seriesStartDate,
            endDate: seriesEndDate,
            allDay: seriesAllDay,
        } only %}
    </section>

    {% if showOverlapWarnings %}
        <div class="calendar-occurrence-overlaps" data-overlap-warning role="status" aria-live="polite"></div>
    {% endif %}

    <div class="calendar-occurrence-details">
        <div class="calendar-occurrence-status">
            {{ forms.lightswitchField({
                label: 'Cancel Occurrence'|t('calendar'),
                id: 'cancelled',
                name: 'cancelled',
                on: cancelled,
                instructions: 'Mark this occurrence as cancelled without deleting it.'|t('calendar'),
                instructionsPosition: 'after',
                fieldClass: 'calendar-occurrence-cancelled',
            }) }}
        </div>

        <div class="calendar-occurrence-meta-row calendar-occurrence-identity">
            {# The ID isn't `slug`, which the title field's slug generator would fill in #}
            {{ forms.textField({
                label: 'Slug'|t('app'),
                id: 'occurrenceSlug',
                name: 'slug',
                value: slug,
                placeholder: generatedSlug,
                instructions: 'Leave blank to use the automatically generated slug.'|t('calendar'),
                instructionsPosition: 'after',
                data: {'error-key': 'slug'},
            }) }}

            {% if code %}
                <div class="field calendar-occurrence-code">
                    <div class="heading">
                        <label>{{ 'Occurrence Code'|t('calendar') }}</label>
                    </div>
                    <div class="input ltr"><code>{{ code }}</code></div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
