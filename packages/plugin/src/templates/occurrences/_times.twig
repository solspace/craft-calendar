{% import '_includes/forms' as forms %}

{% set prefix = readOnly ? 'inherited-' : '' %}
{% set hidden = readOnly ? ownTimes : not ownTimes %}
<fieldset class="{{ readOnly ? 'calendar-occurrence-inherited-times' : 'calendar-occurrence-times' }}{{ allDay ? ' is-all-day' }}{{ hidden ? ' hidden' }}"{{ readOnly or hidden ? ' disabled' }}>
    <legend class="visually-hidden">{{ 'Date & Time'|t('calendar') }}</legend>
    <div class="calendar-occurrence-meta-row">
        {% for picker in [
            {name: 'startDate', label: 'Start', value: startDate},
            {name: 'endDate', label: 'End', value: endDate},
        ] %}
            {{ forms.dateTimeField({
                label: picker.label|t('calendar'),
                id: prefix ~ picker.name,
                name: readOnly ? null : picker.name,
                value: picker.value,
                disabled: readOnly,
                data: {
                    'calendar-occurrence-picker': {
                        value: picker.value.format('Y-m-d\\TH:i:s'),
                        startValue: startDate.format('Y-m-d\\TH:i:s'),
                        kind: picker.name,
                        readOnly: readOnly,
                        formats: formats,
                        weekStartDay: weekStartDay,
                        timeInterval: timeInterval,
                    },
                }|merge(readOnly ? {} : {'error-key': picker.name}),
            }) }}
        {% endfor %}

        {{ forms.lightswitchField({
            label: 'All Day'|t('calendar'),
            id: prefix ~ 'allDay',
            name: readOnly ? 'inheritedTimes[allDay]' : 'allDay',
            on: allDay,
            disabled: readOnly,
            fieldClass: 'calendar-occurrence-all-day',
        }) }}
    </div>
</fieldset>
