{% extends "calendar/layouts/_settings" %}

{% import "_includes/forms" as forms %}

{% set title = "Event Settings"|t("calendar") %}

{% block content %}

    <form action="" method="post" accept-charset="UTF-8">
        <input type="hidden" name="action" value="calendar/settings/save-settings">
        {{ redirectInput('calendar/settings/events') }}
        {{ csrfInput() }}


        {{ forms.selectField({
            first: true,
            label: "Default Event Duration (Minutes)"|t('calendar'),
            instructions: "New timed events end this many minutes after their start time by default."|t('calendar'),
            id: 'eventDuration',
            name: 'settings[eventDuration]',
            options: settings.eventDurations,
            value: settings.eventDuration,
            errors: settings.getErrors('eventDuration')
        }) }}

        {{ forms.selectField({
            label: "Time Picker Interval (Minutes)"|t('calendar'),
            instructions: "Set the number of minutes between options in the Start Time and End Time pickers."|t('calendar'),
            name: 'settings[timeInterval]',
            options: settings.timeIntervals,
            value: settings.timeInterval,
            errors: settings.getErrors('timeInterval')
        }) }}

        {{ forms.lightswitchField({
            label: 'All-Day Events By Default'|t('calendar'),
            instructions: "Create new events with All Day enabled by default. You can change this for each event."|t('calendar'),
            id: 'allDay',
            name: 'settings[allDay]',
            on: settings.allDay,
            errors: settings.getErrors('allDay')
        }) }}

        {{ forms.selectField({
            label: "Late-Night Event Cutoff (Hours)"|t('calendar'),
            instructions: "Keep events that cross midnight on the previous day when they end within this many hours after midnight. For example, 5 means 5:00 AM. Event dates are unchanged."|t('calendar'),
            id: 'overlapThreshold',
            name: 'settings[overlapThreshold]',
            options: settings.overlapThresholds,
            value: settings.overlapThreshold,
            errors: settings.getErrors('overlapThreshold')
        }) }}
    </form>

{% endblock %}
