{% extends "calendar/layouts/_settings" %}

{% import "_includes/forms" as forms %}

{% set title = "General Settings"|t("calendar") %}

{% block content %}

    <form action="" method="post" accept-charset="UTF-8">
        <input type="hidden" name="action" value="calendar/settings/save-settings">
        {{ redirectInput('calendar/settings/general') }}
        {{ csrfInput() }}

        {% if craft.calendar.pro %}

            {{ forms.textField({
                first: true,
                class: "code",
                label: "Plugin Name"|t('calendar'),
                instructions: "Set Calendar's display name in the control panel. Leave blank to use Calendar."|t('calendar'),
                placeholder: craft.calendar.name,
                id: "pluginName",
                name: "settings[pluginName]",
                value: settings.pluginName,
                errors: settings.getErrors("pluginName"),
            }) }}

        {% endif %}

        {{ forms.selectField({
            first: not craft.calendar.pro,
            label: "First Day of Week"|t('calendar'),
            instructions: "Choose the first day of the week for Month and Week views and date pickers. User Preference uses the signed-in user's Craft setting, or Craft's default when no user is signed in."|t('calendar'),
            name: "settings[firstDayOfWeek]",
            value: settings.firstDayOfWeek,
            errors: settings.errors("firstDayOfWeek"),
            options: {
                "-1": "User Preference"|t('calendar'),
                0: "Sunday"|t('calendar'),
                1: "Monday"|t('calendar'),
                2: "Tuesday"|t('calendar'),
                3: "Wednesday"|t('calendar'),
                4: "Thursday"|t('calendar'),
                5: "Friday"|t('calendar'),
                6: "Saturday"|t('calendar'),
            },
        }) }}

        {{ forms.selectField({
            label: "Time Format"|t('calendar'),
            instructions: "Choose 12-hour or 24-hour time for Calendar's control panel views and time pickers. Locale Default uses the current user's formatting locale."|t('calendar'),
            name: "settings[timeFormat]",
            value: settings.timeFormat,
            errors: settings.errors("timeFormat"),
            options: {
                "auto": "Locale Default"|t('calendar'),
                "12-hour": "12-hour format"|t('calendar'),
                "24-hour": "24-hour format"|t('calendar'),
            },
        }) }}

        {{ forms.lightswitchField({
            label: "Show Disabled Events"|t('calendar'),
            instructions: "Display disabled events with faded styling in the control panel Month, Week, and Day views."|t('calendar'),
            id: 'showDisabledEvents',
            name: 'settings[showDisabledEvents]',
            on: settings.showDisabledEvents,
            errors: settings.getErrors('showDisabledEvents')
        }) }}

        {{ forms.lightswitchField({
            label: "Enable Drag and Drop"|t('calendar'),
            instructions: "Allow users with permission to edit events to move or resize them in the control panel Month, Week, and Day views."|t('calendar'),
            id: 'isDragAndDropEnabled',
            name: 'settings[isDragAndDropEnabled]',
            on: settings.isDragAndDropEnabled,
            errors: settings.getErrors('isDragAndDropEnabled')
        }) }}

        {{ forms.lightswitchField({
            label: "Enable Quick Event Creation"|t('calendar'),
            instructions: "Allow users with permission to create events to add them directly from the control panel Month, Week, and Day views."|t('calendar'),
            id: 'quickCreateEnabled',
            name: 'settings[quickCreateEnabled]',
            on: settings.quickCreateEnabled,
            errors: settings.getErrors('quickCreateEnabled')
        }) }}

        {{ forms.lightswitchField({
            label: "Restrict Editing to Own Events"|t('calendar'),
            instructions: "Limit non-admin users to editing or deleting events they authored. Calendar permissions still apply."|t('calendar'),
            id: 'authoredEventEditOnly',
            name: 'settings[authoredEventEditOnly]',
            on: settings.authoredEventEditOnly,
            errors: settings.getErrors('authoredEventEditOnly')
        }) }}

        {{ forms.selectField({
            label: "Default Page"|t('calendar'),
            instructions: "Choose the page that opens when you click Calendar in the control panel navigation."|t('calendar'),
            name: "settings[defaultView]",
            value: settings.defaultView,
            errors: settings.errors("defaultView"),
            options: {
                overview: "Overview"|t('calendar'),
                events: "Events"|t('calendar'),
                calendars: "Calendars"|t('calendar'),
            },
        }) }}

        {{ forms.lightswitchField({
            label: "Hide Demo Installation Banner"|t('calendar'),
            instructions: "Hide the banner that prompts you to install Calendar's demo templates."|t('calendar'),
            id: 'demoBannerDisabled',
            name: 'settings[demoBannerDisabled]',
            on: settings.demoBannerDisabled,
            errors: settings.getErrors('demoBannerDisabled')
        }) }}
    </form>

{% endblock %}
