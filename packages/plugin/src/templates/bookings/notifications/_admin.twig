<div style="max-width:600px;margin:0 auto;padding:28px;font-family:Arial,sans-serif;color:#273445;border:1px solid #dce3ec;border-radius:8px;">
    <p style="margin:0 0 8px;font-size:13px;color:#637083;">{{ 'Booking notification'|t('calendar') }}</p>
    <h1 style="margin:0 0 20px;font-size:24px;line-height:1.3;">{{ calendar.name }}</h1>
    <p><strong>{{ 'Status'|t('calendar') }}:</strong> {{ status }}</p>
    <p><strong>{{ 'Name'|t('calendar') }}:</strong> {{ booking.customerName }}<br>
        <strong>{{ 'Email'|t('calendar') }}:</strong> {{ booking.customerEmail }}</p>
    <p><strong>{{ 'Date'|t('calendar') }}:</strong> {{ date }}<br>
        <strong>{{ 'Time'|t('calendar') }}:</strong> {{ startTime }}–{{ endTime }}<br>
        <strong>{{ 'Timezone'|t('calendar') }}:</strong> {{ timezone }}</p>
    {% if booking.notes %}
        <p><strong>{{ 'Notes'|t('calendar') }}:</strong><br>{{ booking.notes|nl2br }}</p>
    {% endif %}
    {% if statusHandle == 'requested' %}
        <p style="padding:12px 16px;background:#fff5df;border-radius:6px;">{{ 'Requested times are reserved only after confirmation.'|t('calendar') }}</p>
    {% endif %}
    <p style="margin:24px 0 0;"><a href="{{ cpEditUrl }}" style="display:inline-block;padding:10px 16px;background:#334e70;border-radius:5px;color:#ffffff;text-decoration:none;">{{ 'View booking'|t('calendar') }}</a></p>
</div>
