{% extends 'calendar/layouts/_bookings' %}
{% import '_includes/forms' as forms %}
{% set title = 'Booking Schedule'|t('calendar') %}
{% set selectedSubnavItem = 'bookings' %}
{% set bookingView = 'schedule' %}
{% block actionButton %}
<div class="booking-schedule-actions">
    <div class="booking-history-controls" role="group" aria-label="{{ 'Booking history'|t('calendar') }}">
        {% for direction in ['undo', 'redo'] %}
            <button type="button" data-booking-history="{{ direction }}" disabled title="{{ (direction == 'undo' ? 'Undo' : 'Redo')|t('calendar') }}" aria-label="{{ (direction == 'undo' ? 'Undo' : 'Redo')|t('calendar') }}">
                <svg viewBox="0 0 96 80" width="18" height="16" aria-hidden="true" focusable="false"><g{% if direction == 'redo' %} transform="translate(96 0) scale(-1 1)"{% endif %}><path fill="currentColor" d="M37 1 1 30l36 29V41h18c15 0 23 8 23 22 0 6-2 11-5 16 12-8 19-19 19-31 0-20-14-31-37-31H37V1Z"/></g></svg>
            </button>
        {% endfor %}
    </div>
    <a href="{{ cpUrl('calendar/bookings/new', {calendarId}) }}" class="btn submit add icon">{{ 'New booking'|t('calendar') }}</a>
</div>
{% endblock %}
{% block content %}
{% set calendarOptions = [] %}
{% for item in calendars %}{% set calendarOptions = calendarOptions|merge([{value: item.id, label: item.name, data: {color: item.color}}]) %}{% endfor %}
<form method="get" class="booking-toolbar">
    {{ forms.selectize({id: 'booking-schedule-calendar', name: 'calendarId', value: calendarId, options: calendarOptions, selectizeOptions: {dropdownClass: 'selectize-dropdown booking-picker-dropdown', extraPlugins: false}, inputAttributes: {aria: {label: 'Calendar'|t('calendar')}}}) }}
    <div class="booking-toolbar-date">{{ forms.text({type: 'date', id: 'booking-schedule-date', name: 'date', value: date, inputAttributes: {aria: {label: 'Date'|t('app')}}}) }}</div>
    {{ forms.selectize({id: 'booking-schedule-view', class: 'booking-toolbar-view', name: 'view', value: scheduleView, options: [{value: 'day', label: 'Day'|t('calendar')}, {value: 'week', label: 'Week'|t('calendar')}], selectizeOptions: {dropdownClass: 'selectize-dropdown booking-picker-dropdown', searchField: [], extraPlugins: false}, inputAttributes: {aria: {label: 'View'|t('app')}}}) }}
    <button class="btn" type="submit">{{ 'Show'|t('app') }}</button>
    <div class="btngroup booking-toolbar-navigation" role="group" aria-label="{{ 'Date'|t('app') }}">
        <a class="btn" href="{{ cpUrl('calendar/bookings/schedule', {calendarId, view: scheduleView, date: previous}) }}">{{ 'Previous'|t('app') }}</a>
        <a class="btn" href="{{ cpUrl('calendar/bookings/schedule', {calendarId, view: scheduleView, date: next}) }}">{{ 'Next'|t('app') }}</a>
    </div>
    <span class="light booking-toolbar-timezone">{{ calendar.schedulingSettings.timezone }}</span>
</form>
<p class="light">{{ 'Confirmed bookings reserve time. Requested bookings are shown for review.'|t('calendar') }}</p>
<p class="light booking-grid-instructions">{{ 'Click an available time to add a booking. Shaded times are unavailable.'|t('calendar') }}</p>
<div class="booking-grid-scroll"><div class="booking-grid" style="--days:{{ days|length }}">
<div class="booking-grid-times"><div class="booking-day-heading"></div>{% for hour in 0..23 %}<div class="booking-hour-label">{{ ('2000-01-01 ' ~ '%02d:00'|format(hour))|time(bookingTimeFormat, calendar.schedulingSettings.timezone)|calendarTimeLabel }}</div>{% endfor %}</div>
{% for day in days %}<div class="booking-day"><div class="booking-day-heading">{{ day.date|date('icu:EEE', calendar.schedulingSettings.timezone) }} {{ day.date|date('short', calendar.schedulingSettings.timezone) }}</div><div class="booking-day-body" data-date="{{ day.date|date('Y-m-d', calendar.schedulingSettings.timezone) }}">
{% for hour in 0..23 %}<div class="booking-hour"></div>{% endfor %}
{% for minute, slots in day.slots %}
{% for slot in slots %}
{% set slotLabel = 'New booking: {time}'|t('calendar', {time: slot.label}) %}
<a class="booking-slot-target" href="{{ cpUrl('calendar/bookings/new', {calendarId, start: slot.start}) }}" style="top:{{ minute / 60 * 48 }}px;--slot-height:{{ slot.length / 60 * 48 }}px;height:{{ min(calendar.schedulingSettings.increment, 1440 - minute) / 60 * 48 }}px;left:{{ loop.index0 / slots|length * 100 }}%;width:{{ 100 / slots|length }}%" aria-label="{{ day.date|date('Y-m-d', calendar.schedulingSettings.timezone) }} · {{ slotLabel }} · {{ slot.start|date('T', calendar.schedulingSettings.timezone) }}" title="{{ slotLabel }} · {{ slot.start|date('T', calendar.schedulingSettings.timezone) }}"><span>{{ slotLabel }}</span></a>
{% endfor %}
{% endfor %}
{% for item in day.bookings %}<a draggable="true" data-booking-id="{{ item.booking.id }}" class="booking-block {{ item.booking.bookingStatus }}" href="{{ item.booking.cpEditUrl }}" style="top:{{ item.minute / 60 * 48 }}px;min-height:{{ item.length / 60 * 48 }}px;border-left-color:{{ calendar.color }};left:calc({{ item.lane / day.lanes * 100 }}% + 3px);width:calc({{ 100 / day.lanes }}% - 6px)" title="{{ item.booking.customerName }} · {{ item.label }} · {{ statusOptions[item.booking.bookingStatus] }}"><strong>{{ item.booking.customerName }}</strong><span>{{ item.label }}</span><small>{{ statusOptions[item.booking.bookingStatus] }}</small></a>{% endfor %}
</div></div>{% endfor %}
</div></div>
{% endblock %}
{% css %}
.booking-schedule-actions { display:flex; align-items:center; gap:var(--m,14px); }
.booking-history-controls { display:flex; align-items:center; overflow:hidden; border-radius:var(--medium-border-radius,4px); background:#c4cfe1; }
.booking-history-controls button { display:flex; align-items:center; justify-content:center; width:39px; height:34px; padding:0; border:0; background:#c4cfe1; color:#5a6875; cursor:pointer; }
.booking-history-controls button + button { border-left:1px solid #e3ecfb; }
.booking-history-controls button:hover:not(:disabled) { background:#b5c4d8; }
.booking-history-controls button:active:not(:disabled) { background:#a6b4c9; }
.booking-history-controls button:focus-visible { outline:2px solid currentColor; outline-offset:-2px; }
.booking-history-controls button:disabled { background:#d5dfeb; color:#a0aab4; cursor:default; }
.booking-toolbar { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin:0 0 20px; padding:12px; background:var(--gray-050,#f3f6fa); border:1px solid var(--hairline-color,#e4e9ef); border-radius:6px; }
.booking-toolbar > .select.selectize { width:180px; flex-shrink:0; }
.booking-toolbar > .select.selectize.booking-toolbar-view { width:110px; }
.booking-toolbar-date { width:160px; }
.booking-toolbar .selectize-input, .booking-toolbar .text, .booking-toolbar .btn { min-height:34px; box-sizing:border-box; }
.booking-toolbar-date .text { width:100%; }
.booking-toolbar-navigation { display:flex; margin:0; }
.booking-toolbar-timezone { margin-inline-start:auto; font-size:12px; white-space:nowrap; }
.booking-toolbar .selectize-input .item > .flex, .booking-picker-dropdown .option > .flex { gap:8px; }
.booking-toolbar .selectize-input .color.small, .booking-picker-dropdown .color.small { width:12px; height:12px; flex:0 0 12px; margin:0; }
.booking-grid-scroll { max-height:65vh; overflow:auto; border:1px solid var(--hairline-color,#d8dee5); border-radius:8px; }
.booking-grid { display:grid; grid-template-columns:80px repeat(var(--days),minmax(115px,1fr)); min-width:calc(var(--days) * 115px + 80px); }
.booking-day { border-left:1px solid var(--hairline-color,#d8dee5); }
.booking-day-heading { height:42px; display:flex; align-items:center; justify-content:center; position:sticky; top:0; background:var(--white,#fff); z-index:5; font-weight:600; border-bottom:1px solid var(--hairline-color,#d8dee5); }
.booking-day-body { position:relative; height:1152px; background:var(--gray-050,#f4f6f9); }
.booking-grid-instructions { margin-top:-8px; font-size:12px; }
.booking-slot-target { position:absolute; display:block; background:var(--white,#fff); box-shadow:inset 0 -1px var(--hairline-color,#e7ebef); z-index:1; cursor:pointer; }
.booking-slot-target span { display:none; position:absolute; top:0; left:0; width:100%; height:var(--slot-height); box-sizing:border-box; padding:4px 6px; border:2px solid var(--enabled-color,#008a5b); border-radius:4px; background:#e6f2eb; color:#234c36; font-size:11px; line-height:1.4; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; pointer-events:none; }
.booking-slot-target:hover, .booking-slot-target:focus-visible { background:#e6f2eb; outline:2px solid var(--enabled-color,#008a5b); outline-offset:-2px; z-index:3; }
.booking-slot-target:hover span, .booking-slot-target:focus-visible span { display:block; }
.booking-hour, .booking-hour-label { height:48px; box-sizing:border-box; border-bottom:1px solid var(--hairline-color,#e7ebef); }
.booking-hour-label { padding:4px; color:var(--light-text-color,#677586); font-size:11px; text-align:right; }
.booking-block { position:absolute; z-index:4; left:3px; right:3px; padding:4px 6px; box-sizing:border-box; border-left:3px solid; border-radius:4px; background:#e6f2eb; overflow:hidden; color:#234c36; line-height:1.3; }
.booking-block.requested { background:#fff3da; color:#76531b; border-style:dashed; }
.booking-block strong, .booking-block span, .booking-block small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.booking-block strong { font-size:12px; }.booking-block span,.booking-block small { font-size:10px; }
{% endcss %}
{% js %}
{% include 'calendar/bookings/_schedule-js' %}
{% endjs %}
