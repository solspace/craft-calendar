{% import '_includes/forms' as forms %}
{% extends 'calendar/layouts/_bookings' %}
{% set title = 'Fields'|t('app') %}
{% set selectedSubnavItem = 'bookings' %}
{% set bookingView = 'fields' %}
{% set fullPageForm = true %}
{% block actionButton %}<button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>{% endblock %}
{% block content %}
{{ csrfInput() }}{{ actionInput('calendar/bookings/save-fields') }}
<p>{{ 'All scheduling calendars share this booking field layout. Customer name, email, times, status, and notes are included automatically.'|t('calendar') }}</p>
{% include '_includes/fieldlayoutdesigner' with {fieldLayout, customizableUi: true} only %}
<hr>
{% set publicFieldOptions = [] %}{% for uid, element in availablePublicFields %}{% set publicFieldOptions = publicFieldOptions|merge([{value: uid, label: element.field.name}]) %}{% endfor %}
{{ forms.checkboxSelectField({label: 'Guest Booking Fields'|t('calendar'), instructions: 'Choose which simple custom fields visitors may view and submit. Save new layout fields first to make them available here. Other fields stay private for staff.'|t('calendar'), name: 'publicFields', options: publicFieldOptions, values: publicFieldUids}) }}
{% endblock %}
