<form id="{{ formId }}" method="post" class="calendar-booking-form">
    {{ csrfInput() }}{{ actionInput('calendar/bookings/request') }}{{ hiddenInput('calendarId', calendar.id) }}
    <h2>{{ calendar.name }}</h2>
    {% if calendar.description %}<p>{{ calendar.description }}</p>{% endif %}
    <p class="booking-form-timezone">{{ 'Times shown in {timezone}.'|t('calendar', {timezone: settings.timezone}) }}</p>
    <label for="{{ formId }}-date">{{ 'Choose a date'|t('calendar') }}</label>
    <input type="date" id="{{ formId }}-date" name="bookingDate" min="{{ minDate }}" max="{{ maxDate }}" required>
    <fieldset class="booking-times"><legend>{{ 'Available times'|t('calendar') }}</legend><p class="booking-times-message" role="status">{{ 'Choose a date to see available times.'|t('calendar') }}</p><div class="booking-times-options"></div></fieldset>
    <label for="{{ formId }}-name">{{ 'Your name'|t('calendar') }}</label><input type="text" id="{{ formId }}-name" name="customerName" autocomplete="name" maxlength="255" value="{{ booking.customerName ?? '' }}" required>
    <label for="{{ formId }}-email">{{ 'Email address'|t('calendar') }}</label><input type="email" id="{{ formId }}-email" name="customerEmail" autocomplete="email" maxlength="255" value="{{ booking.customerEmail ?? '' }}" required>
    <label for="{{ formId }}-notes">{{ 'Notes'|t('calendar') }}</label><textarea id="{{ formId }}-notes" name="notes" rows="3" maxlength="10000">{{ booking.notes ?? '' }}</textarea>
    {% for field in publicFields %}<div class="booking-custom-field">
        {% if field.type == 'checkboxes' %}<fieldset><legend>{{ field.label }}{{ field.required ? ' *' }}</legend>{% for option in field.options %}<label><input type="checkbox" name="fields[{{ field.handle }}][]" value="{{ option.value }}" {{ option.value in field.selected ? 'checked' }}>{{ option.label }}</label>{% endfor %}</fieldset>
        {% else %}<label for="{{ formId }}-{{ field.handle }}">{{ field.label }}{{ field.required ? ' *' }}</label>
        {% if field.type == 'textarea' %}<textarea id="{{ formId }}-{{ field.handle }}" name="fields[{{ field.handle }}]" rows="3" {{ field.required ? 'required' }}>{{ field.value }}</textarea>
        {% elseif field.type == 'select' %}<select id="{{ formId }}-{{ field.handle }}" name="fields[{{ field.handle }}]" {{ field.required ? 'required' }}><option value="">{{ 'Choose an option'|t('calendar') }}</option>{% for option in field.options %}<option value="{{ option.value }}" {{ option.value == field.value ? 'selected' }}>{{ option.label }}</option>{% endfor %}</select>
        {% else %}<input id="{{ formId }}-{{ field.handle }}" type="{{ field.type }}" name="fields[{{ field.handle }}]" value="{{ field.value }}" {{ field.type == 'number' ? 'step="any"' }} {{ field.required ? 'required' }}>{% endif %}
        {% endif %}
    </div>{% endfor %}
    <div class="booking-honeypot" aria-hidden="true"><label>{{ 'Website'|t('calendar') }}<input name="bookingWebsite" tabindex="-1" autocomplete="off"></label></div>
    {% if settings.requireApproval %}<p>{{ 'Your time is reserved only after confirmation.'|t('calendar') }}</p>{% endif %}
    <button type="submit">{{ (settings.requireApproval ? 'Request booking' : 'Book this time')|t('calendar') }}</button>
    <div class="booking-form-message" role="status" aria-live="polite">{% if booking.hasErrors %}{{ booking.getErrorSummary(true)|join(' ') }}{% endif %}</div>
    <noscript><p>{{ 'Enable JavaScript to select an available timeslot.'|t('calendar') }}</p></noscript>
</form>
{% css %}
.calendar-booking-form { max-width:640px; padding:28px; border:1px solid #dce3eb; border-radius:12px; background:white; color:#273549; }
.calendar-booking-form>label { display:block; margin:18px 0 6px; font-weight:600; }
.calendar-booking-form>input, .calendar-booking-form>textarea, .booking-custom-field input:not([type=checkbox]), .booking-custom-field textarea, .booking-custom-field select { width:100%; box-sizing:border-box; font:inherit; padding:10px 12px; border:1px solid #cad4df; border-radius:6px; }
.calendar-booking-form button { font:inherit; padding:10px 18px; background:#2563eb; color:white; border:0; border-radius:6px; cursor:pointer; }
.calendar-booking-form button:disabled { opacity:.5; cursor:wait; }
.booking-custom-field { margin:18px 0; }.booking-custom-field>label { display:block; font-weight:600; margin-bottom:6px; }.booking-custom-field fieldset { border:0; padding:0; }.booking-custom-field fieldset label { display:block; margin:6px 0; }.booking-custom-field .heading { margin-bottom:6px; }.booking-custom-field .instructions { color:#607085; font-size:13px; }
.booking-form-timezone, .booking-times-message { color:#607085; font-size:14px; }
.booking-times { border:0; padding:0; margin:20px 0; }
.booking-times legend { font-weight:600; }.booking-times-options { display:flex; flex-wrap:wrap; gap:8px; }
.booking-time-option { display:flex; gap:6px; align-items:center; padding:9px; border:1px solid #cbd5e1; border-radius:6px; cursor:pointer; }
.booking-time-option:has(input:checked) { background:#eff6ff; border-color:#2563eb; }
.booking-honeypot { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); }
.booking-form-message { margin-top:16px; }.booking-form-message.error { color:#b42318; }
{% endcss %}
{% js %}
(() => {
    const form = document.getElementById({{ formId|json_encode|raw }});
    const date = form.querySelector('[name="bookingDate"]');
    const options = form.querySelector('.booking-times-options');
    const slotMessage = form.querySelector('.booking-times-message');
    const message = form.querySelector('.booking-form-message');
    const submit = form.querySelector('button[type="submit"]');
    const labels = {{ {loading: 'Loading available times…'|t('calendar'), empty: 'No times are available on this date.'|t('calendar'), error: 'Could not load available times. Please try again.'|t('calendar'), choose: 'Choose an available time.'|t('calendar'), submitError: 'Could not submit your booking. Please try again.'|t('calendar')}|json_encode|raw }};
    let latest = 0;
    date.addEventListener('change', async () => {
        const current = ++latest;
        options.replaceChildren();
        if (!date.value) return;
        slotMessage.textContent = labels.loading;
        try {
            const url = new URL({{ actionUrl('calendar/bookings/slots')|json_encode|raw }}, location.href);
            url.searchParams.set('calendarId', {{ calendar.id }});
            url.searchParams.set('date', date.value);
            const response = await fetch(url, {headers: {'Accept': 'application/json'}, cache: 'no-store'});
            if (!response.ok) throw new Error();
            const data = await response.json();
            if (current !== latest) return;
            slotMessage.textContent = data.slots.length ? '' : labels.empty;
            data.slots.forEach(slot => {
                const label = document.createElement('label');
                label.className = 'booking-time-option';
                const input = document.createElement('input');
                input.type = 'radio'; input.name = 'start'; input.value = slot.start; input.required = true;
                label.append(input, document.createTextNode(slot.label));
                options.append(label);
            });
        } catch (_) { if (current === latest) slotMessage.textContent = labels.error; }
    });
    form.addEventListener('submit', async event => {
        event.preventDefault();
        if (!form.querySelector('[name="start"]:checked')) { message.textContent = labels.choose; return; }
        submit.disabled = true;
        message.textContent = ''; message.classList.remove('error');
        try {
            const response = await fetch({{ actionUrl('calendar/bookings/request')|json_encode|raw }}, {method:'POST', body:new FormData(form), headers:{'Accept':'application/json'}});
            const data = await response.json();
            if (!response.ok) { message.classList.add('error'); message.textContent = data.errors ? Object.values(data.errors).flat().join(' ') : data.message || labels.submitError; return; }
            message.textContent = data.message;
            form.reset(); options.replaceChildren(); slotMessage.textContent = labels.choose;
        } catch (_) { message.classList.add('error'); message.textContent = labels.submitError; }
        finally { submit.disabled = false; }
    });
})();
{% endjs %}
