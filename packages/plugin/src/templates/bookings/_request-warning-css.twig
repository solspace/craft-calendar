.booking-request-warning { display:inline-flex; align-items:center; flex-shrink:0; margin-inline-start:6px; color:var(--warning-color,#966000); vertical-align:middle; line-height:1; }
.booking-request-warning[hidden] { display:none !important; }
.booking-request-warning > [data-icon] { font-size:12px; }
a.booking-request-warning:hover, a.booking-request-warning:focus-visible { color:var(--warning-color,#966000); }
a.booking-request-warning:focus-visible { outline:2px solid currentColor; outline-offset:3px; border-radius:2px; }
.booking-block strong { display:flex; align-items:center; }
.booking-block .booking-customer-name { min-width:0; flex:1; font-size:inherit; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.booking-block .booking-request-warning { margin-inline-start:4px; }
