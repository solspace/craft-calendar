{% import '_includes/forms' as forms %}
{% set statusIcons = {requested: '…', confirmed: '✓', declined: '×', cancelled: '−'} %}
<section class="booking-status booking-status-card {{ booking.bookingStatus }}" id="booking-status-card" aria-labelledby="booking-status-heading">
    <div class="booking-status-header">
        <span class="booking-status-icon" aria-hidden="true">{{ statusIcons[booking.bookingStatus] ?? '…' }}</span>
        <label id="booking-status-heading" for="booking-status">{{ 'Booking Status'|t('calendar') }}</label>
        {{ forms.select({name: 'bookingStatus', id: 'booking-status', options: statusOptions, value: booking.bookingStatus, inputAttributes: {aria: {invalid: booking.hasErrors('bookingStatus') ? 'true' : null, describedby: booking.hasErrors('bookingStatus') ? 'booking-status-errors' : null}}}) }}
    </div>
    <div class="booking-status-body">
        {% if booking.hasErrors('bookingStatus') %}<div id="booking-status-errors">{{ forms.errorList(booking.getErrors('bookingStatus')) }}</div>{% endif %}
        {% include 'calendar/bookings/_status-meta' %}
    </div>
</section>
