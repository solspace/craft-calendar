{% import '_includes/forms' as forms %}
{% set statusIcons = {requested: '?', confirmed: '✓', declined: '×', cancelled: '−'} %}
<section class="booking-status booking-status-card {{ booking.bookingStatus }}" id="booking-status-card" aria-label="{{ 'Booking Status'|t('calendar') }}">
    <div class="booking-status-header">
        <div class="booking-status-picker">
            <span class="booking-status-icon" aria-hidden="true">{{ statusIcons[booking.bookingStatus] ?? '?' }}</span>
            {{ forms.select({disabled: not (canChangeStatus ?? true), name: 'bookingStatus', id: 'booking-status', options: statusOptions, value: booking.bookingStatus, inputAttributes: {aria: {label: 'Booking Status'|t('calendar'), invalid: booking.hasErrors('bookingStatus') ? 'true' : null, describedby: booking.hasErrors('bookingStatus') ? 'booking-status-errors' : null}}}) }}
            {% if canChangeStatus is defined and not canChangeStatus %}<input type="hidden" name="bookingStatus" value="{{ booking.bookingStatus }}">{% endif %}
            {% if booking.statusChangedAt %}
                <time class="booking-status-relative" datetime="{{ booking.statusChangedAt|atom }}" data-now="{{ 'now'|date('U') }}" title="{{ booking.statusChangedAt|datetime('full') }}">{{ booking.statusChangedAt|calendarRelativeTime }}</time>
            {% endif %}
        </div>
        {% include 'calendar/bookings/_status-meta' %}
    </div>
    {% if booking.hasErrors('bookingStatus') %}<div class="booking-status-body" id="booking-status-errors">{{ forms.errorList(booking.getErrors('bookingStatus')) }}</div>{% endif %}
</section>
