{% set resourceLabels = craft.calendar.bookingResourceLabels %}
const bookingCalendarPicker = document.querySelector('#{{ calendarPickerPrefix }}-calendar-picker');
const bookingCalendarMenu = document.querySelector('#{{ calendarPickerPrefix }}-calendar-menu');
const bookingCalendarChoices = [...bookingCalendarMenu.querySelectorAll('[data-calendar-choice]')];
const bookingCalendarAll = bookingCalendarMenu.querySelector('[data-calendar-all]');
const bookingCalendarInput = bookingCalendarPicker.closest('form').elements.namedItem('calendarIds');
const bookingCalendarDisclosure = $(bookingCalendarPicker).data('disclosureMenu') || new Garnish.DisclosureMenu(bookingCalendarPicker);
function syncBookingCalendarPicker(selection) {
    const ids = selection.split(',');
    bookingCalendarChoices.forEach(input => input.checked = selection === 'all' || ids.includes(input.dataset.calendarChoice));
    const selected = bookingCalendarChoices.filter(input => input.checked);
    bookingCalendarAll.checked = selected.length === bookingCalendarChoices.length;
    bookingCalendarAll.indeterminate = selected.length > 0 && !bookingCalendarAll.checked;
    bookingCalendarInput.value = bookingCalendarAll.checked ? 'all' : selected.map(input => input.dataset.calendarChoice).join(',');
    bookingCalendarPicker.querySelector('[data-calendar-label]').textContent = bookingCalendarAll.checked
        ? {{ resourceLabels.all|json_encode|raw }}
        : (selected.length === 1 ? selected[0].dataset.calendarName : Craft.t('calendar', {{ resourceLabels.count|json_encode|raw }}, {count: selected.length, label: {{ resourceLabels.plural|json_encode|raw }}}));
}
syncBookingCalendarPicker(bookingCalendarInput.value);
bookingCalendarMenu.addEventListener('change', event => {
    if (event.target === bookingCalendarAll) {
        bookingCalendarChoices.forEach(input => input.checked = bookingCalendarAll.checked);
        if (!bookingCalendarAll.checked) bookingCalendarChoices[0].checked = true;
    }
    const selected = bookingCalendarChoices.filter(input => input.checked);
    // Keep the final calendar checked so an empty selection cannot broaden the filter.
    if (!selected.length) { event.target.checked = true; return; }
    syncBookingCalendarPicker(selected.map(input => input.dataset.calendarChoice).join(','));
    {{ calendarPickerChange }}();
});
