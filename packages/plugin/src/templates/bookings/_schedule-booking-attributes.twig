data-booking-id="{{ item.booking.id }}"
data-calendar-id="{{ resource.id }}"
data-increment="{{ resource.schedulingSettings.increment }}"
data-duration="{{ (item.booking.endDate.timestamp - item.booking.startDate.timestamp) / 60 }}"
data-customer="{{ item.booking.customerName }}"
data-calendar-name="{{ resource.name }}"
data-start-date="{{ item.booking.startDate|date('Y-m-d', displayTimezone) }}"
data-start-minute="{{ item.booking.startDate|date('H', displayTimezone) * 60 + item.booking.startDate|date('i', displayTimezone) }}"
data-original-time="{{ item.booking.startDate|date('short', displayTimezone) }} · {{ item.booking.startDate|time(bookingTimeFormat, displayTimezone)|calendarTimeLabel }}"
data-can-reschedule="{{ bookingPermissions[resource.id].reschedule ? 'true' : 'false' }}"
