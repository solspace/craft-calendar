const bookingGridScroll = document.querySelector('.booking-grid-scroll');
bookingGridScroll.scrollTop = 7 * 48;
const bookingHistoryButtons = document.querySelectorAll('[data-booking-history]');
const bookingToolbar = document.querySelector('.booking-toolbar');
const bookingSpinner = bookingToolbar.querySelector('.spinner');
{% include 'calendar/bookings/_calendar-picker-js' with {calendarPickerPrefix: 'booking-schedule', calendarPickerChange: 'filterBookingSchedule'} %}
let bookingFilterValues = new FormData(bookingToolbar);
let bookingScheduleLoading = false;
let bookingScheduleRevision = 0;
let bookingScheduleRequest;
let pendingBookingSchedule;
let bookingDateTimer;
function bookingHistoryKey() {
    return 'calendar-booking-history:{{ currentUser.id }}:' + bookingGridScroll.querySelector('.booking-grid').dataset.calendarIds + ':' + bookingGridScroll.querySelector('.booking-grid').dataset.timezone + ':' + {{ cpUrl('calendar/bookings/schedule')|json_encode|raw }};
}
let bookingPast = [];
let bookingFuture = [];
let bookingBusy = false;
let draggedBooking = null;
{% include 'calendar/bookings/_schedule-options-js' %}
function loadBookingHistory() {
    bookingPast = [];
    bookingFuture = [];
    try {
        const stored = JSON.parse(sessionStorage.getItem(bookingHistoryKey()));
        if (stored && stored.expires > Date.now() && Array.isArray(stored.past) && Array.isArray(stored.future)) {
            bookingPast = stored.past.filter(token => typeof token === 'string').slice(-50);
            bookingFuture = stored.future.filter(token => typeof token === 'string').slice(-50);
        }
    } catch (_) { /* History remains available in memory when storage is unavailable. */ }
}
loadBookingHistory();
function updateBookingHistory() {
    const busy = bookingBusy || bookingScheduleLoading;
    bookingHistoryButtons.forEach(button => {
        button.disabled = busy || !(button.dataset.bookingHistory === 'undo' ? bookingPast.length : bookingFuture.length);
    });
    bookingGridScroll.querySelectorAll('.booking-block').forEach(block => block.draggable = !busy && block.dataset.canReschedule === 'true');
}
function retainBookingHistory() {
    try {
        sessionStorage.setItem(bookingHistoryKey(), JSON.stringify({past: bookingPast, future: bookingFuture, expires: Date.now() + 7200000}));
    } catch (_) { /* Keep the current page's history even without session storage. */ }
    updateBookingHistory();
}
function setBookingFilters(values) {
    syncBookingCalendarPicker(values.get('calendarIds'));
    for (const name of ['date', 'view', 'layout', 'timezone']) {
        const input = bookingToolbar.elements.namedItem(name);
        if (input.selectize) input.selectize.setValue(values.get(name), true);
        else input.value = values.get(name);
    }
}
function updateBookingTimezoneOptions(select) {
    const input = bookingToolbar.elements.namedItem('timezone');
    if (input.selectize) {
        const picker = input.selectize;
        picker.clear(true);
        picker.clearOptions(true);
        picker.addOption([...select.options].map(option => ({value: option.value, text: option.text})));
    } else {
        input.replaceChildren(...[...select.options].map(option => option.cloneNode(true)));
    }
}
async function filterBookingSchedule(url) {
    clearTimeout(bookingDateTimer);
    if (!url) {
        if (!bookingToolbar.checkValidity()) return;
        url = new URL(location.href);
        url.searchParams.delete('calendarId');
        for (const [name, value] of new FormData(bookingToolbar)) url.searchParams.set(name, value);
    }
    if (bookingBusy) { pendingBookingSchedule = url; return; }
    pendingBookingSchedule = null;
    const current = ++bookingScheduleRevision;
    bookingScheduleRequest?.abort();
    const request = bookingScheduleRequest = new AbortController();
    bookingScheduleLoading = true;
    closeBookingOptions();
    clearBookingDrag();
    bookingGridScroll.setAttribute('aria-busy', 'true');
    bookingSpinner.classList.remove('hidden');
    updateBookingHistory();
    try {
        const response = await fetch(url, {credentials: 'same-origin', cache: 'no-store', signal: request.signal});
        if (!response.ok) throw new Error();
        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        if (current !== bookingScheduleRevision) return;
        const grid = doc.querySelector('.booking-grid');
        const toolbar = doc.querySelector('.booking-toolbar');
        const newBooking = doc.querySelector('[data-booking-new]');
        const timezoneSelect = toolbar?.elements.namedItem('timezone');
        if (!grid || !toolbar || !newBooking || !timezoneSelect) throw new Error();
        const currentGrid = bookingGridScroll.querySelector('.booking-grid');
        const calendarChanged = grid.dataset.calendarIds !== currentGrid.dataset.calendarIds || grid.dataset.timezone !== currentGrid.dataset.timezone;
        bookingGridScroll.replaceChildren(document.importNode(grid, true));
        // Keep the existing controls and scroll position; the returned page supplies canonical values and links.
        bookingFilterValues = new FormData(toolbar);
        updateBookingTimezoneOptions(timezoneSelect);
        setBookingFilters(bookingFilterValues);
        bookingToolbar.querySelector('.booking-toolbar-navigation').innerHTML = toolbar.querySelector('.booking-toolbar-navigation').innerHTML;
        bookingToolbar.querySelector('.booking-toolbar-timezone').title = toolbar.querySelector('.booking-toolbar-timezone').title;
        document.querySelector('[data-booking-new]').href = newBooking.href;
        document.querySelector('[data-booking-new]').hidden = newBooking.hidden;
        const historyControls = document.querySelector('.booking-history-controls');
        const returnedHistory = doc.querySelector('.booking-history-controls');
        if (historyControls && returnedHistory) historyControls.classList.toggle('hidden', returnedHistory.classList.contains('hidden'));
        document.querySelector('[data-booking-instructions]').textContent = doc.querySelector('[data-booking-instructions]').textContent;
        history.replaceState(null, '', url);
        if (calendarChanged) loadBookingHistory();
    } catch (_) {
        if (current === bookingScheduleRevision && !request.signal.aborted) {
            setBookingFilters(bookingFilterValues);
            Craft.cp.displayError(Craft.t('app', 'An unknown error occurred.'));
        }
    } finally {
        if (current === bookingScheduleRevision) {
            bookingScheduleLoading = false;
            bookingGridScroll.removeAttribute('aria-busy');
            bookingSpinner.classList.add('hidden');
            updateBookingHistory();
        }
    }
}
// Bind to the toolbar because Selectize initialization clears handlers bound directly to its selects.
$(bookingToolbar).on('change', '#booking-schedule-date, #booking-schedule-view, #booking-schedule-layout, #booking-schedule-timezone', () => filterBookingSchedule());
bookingToolbar.querySelector('#booking-schedule-date').addEventListener('input', () => {
    clearTimeout(bookingDateTimer);
    bookingDateTimer = setTimeout(() => filterBookingSchedule(), 300);
});
bookingToolbar.addEventListener('submit', event => { event.preventDefault(); filterBookingSchedule(); });
bookingToolbar.addEventListener('click', event => {
    const link = event.target.closest('.booking-toolbar-navigation a');
    if (!link || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    if (bookingScheduleLoading || pendingBookingSchedule) return;
    filterBookingSchedule(new URL(link.href));
});
document.querySelector('[data-booking-new]').addEventListener('click', event => {
    if (bookingScheduleLoading || pendingBookingSchedule) event.preventDefault();
});
function finishBookingChange() {
    bookingBusy = false;
    updateBookingHistory();
    if (pendingBookingSchedule) filterBookingSchedule(pendingBookingSchedule);
}
async function refreshBookingSchedule() {
    closeBookingOptions();
    try {
        const response = await fetch(location.href, {credentials: 'same-origin', cache: 'no-store'});
        if (!response.ok) throw new Error();
        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const grid = doc.querySelector('.booking-grid');
        if (!grid) throw new Error();
        bookingGridScroll.replaceChildren(document.importNode(grid, true));
    } catch (_) {
        Craft.cp.displayError(Craft.t('calendar', 'The booking was saved, but the schedule could not refresh. Reload this page.'));
    }
}
async function replayBookingHistory(direction) {
    if (bookingBusy || bookingScheduleLoading) return;
    const entries = direction === 'undo' ? bookingPast : bookingFuture;
    const token = entries.at(-1);
    if (!token) return;
    bookingBusy = true;
    updateBookingHistory();
    try {
        const response = await Craft.sendActionRequest('POST', 'calendar/bookings/history', {data: {token, direction}});
        if (!response.data.success) {
            Craft.cp.displayError(response.data.message);
            return;
        }
        entries.pop();
        (direction === 'undo' ? bookingFuture : bookingPast).push(token);
        retainBookingHistory();
        await refreshBookingSchedule();
    } catch (_) {
        Craft.cp.displayError(Craft.t('calendar', 'Could not restore the booking change.'));
    } finally {
        finishBookingChange();
    }
}
bookingHistoryButtons.forEach(button => button.addEventListener('click', () => replayBookingHistory(button.dataset.bookingHistory)));
{% include 'calendar/bookings/_schedule-drag-js' %}
document.addEventListener('keydown', event => {
    if (bookingBusy || bookingScheduleLoading || event.defaultPrevented || event.altKey || !(event.metaKey || event.ctrlKey)) return;
    if (event.target instanceof HTMLElement && event.target.closest('input, textarea, select, [contenteditable]:not([contenteditable=false]), [role=textbox]')) return;
    if (document.querySelector('.modal:not(.hidden), .cp-screen-slideout:not(.hidden)')) return;
    const key = event.key.toLowerCase();
    const direction = key === 'z' ? (event.shiftKey ? 'redo' : 'undo') : (key === 'y' && event.ctrlKey ? 'redo' : null);
    if (!direction || !(direction === 'undo' ? bookingPast.length : bookingFuture.length)) return;
    event.preventDefault();
    replayBookingHistory(direction);
});
updateBookingHistory();
