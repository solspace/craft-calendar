{% set repeatRulesEnabled = event.calendar.allowRepeatingEvents ?? true %}

<div
  id="event-builder"
  data-event-builder
  {{ craft.calendar.isPro ? 'data-pro' }}
  {{ repeatRulesEnabled ? 'data-repeat-rules-enabled' }}
></div>

<input
  type="hidden"
  name="event_builder_data"
  data-event-builder-data
  value="{{ eventData|json_encode|e('html_attr') }}"
/>

<input type="hidden" name="calendarId" value="{{ event.calendarId }}" />

{% js %}
  var existingEventData = {{ eventData|json_encode|raw }};
  var eventConfig = {{ eventConfig|json_encode|raw }};
{% endjs %}
