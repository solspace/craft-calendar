{
  "name": "@cal/app",
  "version": "1.0.0",
  "description": "Calendar App",
  "scripts": {
    "dev": "NODE_ENV=development npm run watch",
    "build": "npm run clean && NODE_ENV=production npm run compile",
    "watch": "webpack serve --config ./config/webpack/dev.config.js",
    "clean": "rm -rf ../plugin/src/Resources/js/app",
    "compile": "webpack --config ./config/webpack/prod.config.js",
    "lint": "eslint . --ignore-pattern '{config/**/*}' --max-warnings 0",
    "lint:fix": "eslint --fix . --ignore-pattern '{config/**/*}'",
    "test": "vitest --config ./config/vitest/vitest.config.ts"
  },
  "keywords": [
    "Calendar",
    "Craft CMS",
    "App"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-devtools": "^5.91.2",
    "axios": "^1.13.2",
    "browserslist": "^4.28.1",
    "date-fns": "^4.1.0",
    "react": "^19.2.3",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.3",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "redux": "^5.0.1",
    "styled-components": "^6.2.0",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@redux-devtools/core": "^4.1.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.7",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/url-parse": "^1.4.11",
    "@types/webpack": "^5.28.5",
    "autoprefixer": "^10.4.23",
    "css-loader": "^7.1.2",
    "react-refresh": "^0.18.0",
    "react-refresh-typescript": "^2.0.11",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript-plugin-styled-components": "^3.0.0",
    "url-loader": "^4.1.1",
    "vitest": "^4.0.16",
    "vitest-tsconfig-paths": "^3.4.1",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not IE_Mob 11",
    "last 2 versions"
  ]
}
