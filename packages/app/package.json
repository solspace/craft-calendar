{
  "name": "@cal/app",
  "version": "1.0.0",
  "description": "Calendar App",
  "scripts": {
    "dev": "NODE_ENV=development npm run watch",
    "build": "npm run clean && NODE_ENV=production npm run compile",
    "watch": "webpack serve --config ./config/webpack/dev.config.js",
    "clean": "rm -rf ../plugin/src/Resources/js/app",
    "compile": "webpack --config ./config/webpack/prod.config.js",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest --config ./config/vitest/vitest.config.ts"
  },
  "keywords": [
    "Calendar",
    "Craft CMS",
    "App"
  ],
  "author": "Solspace Inc.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/rrule": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@reduxjs/toolkit": "^2.11.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "luxon": "^3.7.2",
    "react": "^19.2.4",
    "react-datepicker": "9.1.0",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "react-tiny-popover": "^8.1.6",
    "redux": "^5.0.1",
    "rrule": "^2.8.1",
    "styled-components": "^6.3.11",
    "temporal-polyfill": "^0.3.2",
    "url-parse": "^1.5.10",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@redux-devtools/core": "^5.0.0",
    "@svgr/webpack": "^8.1.0",
    "@types/jquery": "^4.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@types/url-parse": "^1.4.11",
    "@types/webpack": "^5.28.5",
    "css-loader": "^7.1.4",
    "dotenv": "^17.3.1",
    "react-refresh": "^0.18.0",
    "react-refresh-typescript": "^2.0.12",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.4.0",
    "ts-loader": "^9.5.4",
    "typescript-plugin-styled-components": "^3.0.0",
    "url-loader": "^4.1.1",
    "vitest": "^4.1.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1"
  }
}
