{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../plugin/src/Resources/js/app/",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM"],
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "jquery"],
    "typeRoots": ["config/@types", "./node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "@cal/*": ["app/src/*"],
      "@config/*": ["app/config/*"],
      "@widgets/*": ["app/src/standalone/widgets/*"],
      "@event-builder/*": ["app/src/standalone/event-builder/*"]
    }
  },
  "exclude": ["node_modules"]
}
