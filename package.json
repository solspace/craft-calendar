{
  "name": "root",
  "private": true,
  "description": "Calendar plugin for Craft",
  "engines": {
    "pnpm": ">=11"
  },
  "workspaces": [
    "packages/app",
    "packages/styles"
  ],
  "dependencies": {
    "globals": "^17.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "concurrently -n app,styles \"pnpm --filter @cal/app dev\" \"pnpm --filter @cal/styles dev\"",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm -r --if-present test"
  },
  "author": "Solspace, Inc.",
  "license": "ISC"
}
