{
  "name": "root",
  "private": true,
  "description": "Calendar plugin for Craft",
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^7.13.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-config-react": "^1.1.7",
    "eslint-plugin-prettier": "^3.1.4",
    "eslint-plugin-react": "^7.21.5",
    "prettier": "^2.1.2"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev --workspace=@cal/event-builder\" \"npm run dev --workspace=@cal/scripts\" \"npm run dev --workspace=@cal/styles\"",
    "build": "npm run build --workspaces",
    "format": "prettier --write '**/*.{ts,tsx,md,json,js,jsx,css,scss}'",
    "format:verify": "prettier --list-different '**/*.{ts,tsx,md,json,js,jsx,css,scss}'",
    "lint": "npm run lint --workspaces --if-present",
    "bootstrap": "npm install",
    "test": "npm run test --workspaces --if-present"
  },
  "author": "Solspace, Inc.",
  "license": "ISC",
  "workspaces": [
    "packages/event-builder",
    "packages/scripts",
    "packages/styles"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  }
}
