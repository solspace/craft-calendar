{
  "name": "root",
  "private": true,
  "description": "Calendar plugin for Craft",
  "workspaces": [
    "packages/app",
    "packages/scripts",
    "packages/styles"
  ],
  "dependencies": {
    "globals": "^17.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "browserslist": "^4.28.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "npm run dev --workspace @cal/app & npm run dev --workspace @cal/scripts & npm run dev --workspace @cal/styles & wait",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
